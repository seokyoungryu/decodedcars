---
// Printable pre-purchase checklist for one model year, generated from its recalls, complaints and ratings.
import { VIN_LOOKUP } from '@/config/site';
import { type Campaign, type Model, type Year, comp, n } from '@/lib/data';
interface Props {
  m: Model;
  y: Year;
  recalls: Campaign[];
}
const { m, y, recalls } = Astro.props;
const name = `${y.year} ${m.make} ${m.model}`;
const ev = y.fuels.includes('EV');
const hybrid = y.fuels.some((f) => /Hybrid/.test(f));
const tops = y.complaints.comps.filter(([c]) => !/UNKNOWN/i.test(c)).slice(0, 3);
// what to physically check for the most-reported systems
const TIP: [RegExp, string][] = [
  [/AIR BAG|SEAT BELT/i, 'confirm the airbag warning light turns off after start-up and any airbag recall was completed'],
  [/ENGINE|POWER TRAIN|FUEL/i, 'cold-start the engine, listen for knocking, and watch for warning lights or hesitation on acceleration'],
  [/TRANSMISSION|POWER TRAIN/i, 'test-drive through all gears, including reverse; note slipping, harsh or delayed shifts'],
  [/BRAKE/i, 'brake firmly from speed; check for pulling, pulsing pedal or ABS warning light'],
  [/STEERING/i, 'turn lock-to-lock while parked and on the road; listen for noises and feel for heavy or loose steering'],
  [/ELECTRICAL|BATTERY/i, 'test every window, lock, light, screen and USB port; check the battery age'],
  [/SUSPENSION/i, 'drive over bumps and listen for clunks; look for uneven tire wear'],
  [/AIR CONDITIONING|CLIMATE|HVAC/i, 'run the A/C on max for several minutes and confirm it blows cold'],
  [/COLLISION|LANE|BACK OVER|CAMERA/i, 'make sure driver-assist systems and the backup camera work without error messages'],
  [/STRUCTURE|BODY|LATCH|DOOR/i, 'open and close every door, the hood and tailgate; look for rust or misaligned panels'],
  [/VISIBILITY|WIPER|LIGHT/i, 'check all exterior lights, wipers and the windshield for cracks'],
];
const tipFor = (c: string) => TIP.find(([re]) => re.test(c))?.[1] ?? 'ask the seller and mechanic specifically about this system';
---

<section class="section" id="checklist">
  <div class="section-head"><h2>Used {name} buyer's checklist</h2><button class="print-btn" type="button" onclick="window.print()">Print</button></div>
  <ol class="card checklist">
    <li><b>Run the VIN for open recalls.</b> {recalls.length ? `This model year has ${recalls.length} recall campaign${recalls.length > 1 ? 's' : ''}` : 'No recalls are on file for this model year, but check anyway'} — enter the VIN at <a href={VIN_LOOKUP} target="_blank" rel="noopener">nhtsa.gov/recalls</a> and ask the seller for proof that recall repairs were done.</li>
    {
      recalls.some((r) => r.doNotDrive || r.parkOutside) && (
        <li><b>Safety-critical recall.</b> At least one recall carries a "Do Not Drive" or "Park Outside" warning. Do not buy until the VIN shows it was repaired.</li>
      )
    }
    {
      tops.map(([c, count]) => (
        <li><b>{comp(c)}</b> — {n(count)} owner reports. {tipFor(c).replace(/^./, (x) => x.toUpperCase())}.</li>
      ))
    }
    {y.complaints.miles && <li><b>Mileage to watch.</b> Owners typically reported problems around {n(y.complaints.miles)} miles; ask what was repaired near that point.</li>}
    {ev && <li><b>Battery health.</b> Ask for a battery state-of-health report, check the remaining battery warranty, and compare the displayed range at 100% charge with the EPA's {y.range ?? '–'} miles.</li>}
    {hybrid && !ev && <li><b>Hybrid system.</b> Check for hybrid-system warning lights and ask whether the high-voltage battery has been replaced or is still under warranty.</li>}
    <li><b>Service records and history report.</b> Check maintenance records, accident history and title status before paying.</li>
    <li><b>Independent inspection.</b> Have a mechanic you choose inspect the car before purchase.</li>
  </ol>
  <p class="small muted">Generated by CarRadar from NHTSA recalls and owner complaints for the {name}. Not a substitute for a professional inspection.</p>
</section>
