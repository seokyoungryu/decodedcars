---
// "Which year should I buy?" — best and (if one clearly stands out) worst used model year, with the numbers behind it.
import Stars from '@/components/Stars.astro';
import { type Model, comp, href, n } from '@/lib/data';
interface Props {
  m: Model;
}
const { m } = Astro.props;
const v = m.verdict!;
const reason = (y: NonNullable<typeof v.worst>) =>
  [`${n(y.complaints)} owner complaint${y.complaints === 1 ? '' : 's'}`, `${y.recalls} recall${y.recalls === 1 ? '' : 's'}`, y.fire ? `${y.fire} fire report${y.fire === 1 ? '' : 's'}` : '', y.crash ? `${y.crash} crash report${y.crash === 1 ? '' : 's'}` : ''].filter(Boolean).join(' · ');
---

<section class="section" id="best-years">
  <div class="section-head"><h2>Best and worst years to buy used</h2></div>
  <div class="grid">
    <a class="card verdict good-card" href={href(m, v.best.year)}>
      <span class="badge good">Best year</span>
      <h3 style="font-size:1.4rem;margin:6px 0 4px">{v.best.year} {m.model}</h3>
      <p class="small muted" style="margin:0">{reason(v.best)}</p>
      {v.best.overall && <p class="small" style="margin:6px 0 0">NHTSA overall: <Stars value={v.best.overall} /></p>}
    </a>
    {
      v.worst ? (
        <a class="card verdict bad-card" href={href(m, v.worst.year)}>
          <span class="badge bad">Year to avoid</span>
          <h3 style="font-size:1.4rem;margin:6px 0 4px">{v.worst.year} {m.model}</h3>
          <p class="small muted" style="margin:0">{reason(v.worst)}</p>
          {v.worst.top && <p class="small" style="margin:6px 0 0">Most reported: {comp(v.worst.top)}</p>}
        </a>
      ) : (
        <div class="card">
          <span class="badge">No clear problem year</span>
          <p class="small muted" style="margin:8px 0 0">None of the {v.compared} model years we compared stands out for complaints or recalls.</p>
        </div>
      )
    }
  </div>
  <p class="small muted">Based on NHTSA recalls and owner complaints (received since 2015, crashes and fires weighted more) for {v.compared} model years from 2015 that are at least two years old. Complaint counts are not adjusted for how many cars were sold, so use this alongside a pre-purchase inspection and the car's service history.</p>
</section>
