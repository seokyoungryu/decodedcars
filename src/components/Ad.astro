---
// One AdSense slot. Nothing renders until ADSENSE_CLIENT and a slot ID are set (Auto ads are handled in Base).
// Policy: labeled "Advertisement", never next to navigation or the VIN-lookup button.
import { ADSENSE_CLIENT, ADSENSE_SLOTS } from '@/config/site';
interface Props {
  place: keyof typeof ADSENSE_SLOTS;
}
const slot = ADSENSE_CLIENT && ADSENSE_SLOTS[Astro.props.place];
---

{
  slot && (
    <aside class="ad" aria-label="Advertisement">
      <span class="ad-label">Advertisement</span>
      <ins class="adsbygoogle" style="display:block" data-ad-client={ADSENSE_CLIENT} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true" />
      <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
    </aside>
  )
}
