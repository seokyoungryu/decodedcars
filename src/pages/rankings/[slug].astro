---
import Base from '@/layouts/Base.astro';
import Ad from '@/components/Ad.astro';
import { date, href, n, updatedLabel } from '@/lib/data';
import { RANKINGS, type RankDef } from '@/lib/rankings';

export function getStaticPaths() {
  return RANKINGS.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}
const { r } = Astro.props as { r: RankDef };
const rows = r.rows();
// a written read-out of the list: leaders and which makes dominate it
const nm = (x: (typeof rows)[number]) => `${r.yearLink && x.year ? `${x.year} ` : ''}${x.make} ${x.model}`;
const makeCount = new Map<string, number>();
for (const x of rows) makeCount.set(x.make, (makeCount.get(x.make) ?? 0) + 1);
const topMakes = [...makeCount].sort((a, b) => b[1] - a[1]).filter(([, c]) => c > 1).slice(0, 3);
const readout = rows.length >= 3 ? [
  `The ${nm(rows[0])} leads this list (${r.value(rows[0])}), ahead of the ${nm(rows[1])} (${r.value(rows[1])}) and the ${nm(rows[2])} (${r.value(rows[2])}).`,
  `The list covers ${rows.length} models from ${makeCount.size} makes.${topMakes.length ? ` ${topMakes.map(([m, c]) => `${m} has ${c}`).join(', ')}.` : ''}`,
  rows.length >= 10 ? `Rounding out the top ten: ${rows.slice(3, 10).map(nm).join(', ')}.` : '',
  rows.length >= 15 ? `Further down, places ${rows.length - 2} to ${rows.length} go to the ${rows.slice(-3).map(nm).join(', the ')} (${r.value(rows.at(-1)!)} for the last).` : '',
].filter(Boolean) : [];
const link = (x: (typeof rows)[number]) => (r.yearLink && x.year ? href(x, x.year) : href(x));
// bar length: share of the best figure (inverted when lower is better)
const nums = rows.map((x) => r.num?.(x)).filter((v): v is number => v != null && v > 0);
const best = r.low ? Math.min(...nums) : Math.max(...nums);
const bar = (x: (typeof rows)[number]) => {
  const v = r.num?.(x);
  if (v == null || !nums.length || v <= 0) return undefined;
  return Math.max(6, Math.round((r.low ? best / v : v / best) * 100));
};
const sub = (x: (typeof rows)[number]) => [x.cls as string | undefined, r.slug === 'trending' ? `${n(x.week as number)} views this week` : '', r.slug === 'new-models' && x.added ? `added ${date(x.added as string)}` : ''].filter(Boolean).join(' · ');
---

<Base title={r.title} description={r.intro.slice(0, 155)} section="rankings" noindex={rows.length < 5}>
  <section class="band rk-hero" style={`--rk:${r.accent}`}>
    <div class="crumbs"><a href="/rankings">Rankings</a></div>
    <span class="rk-icon big"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={r.icon} /></svg></span>
    <h1 style="margin-top:12px">{r.title}</h1>
    <p class="lead">{r.intro}</p>
    <p class="small" style="color:var(--chrome-mute)">{updatedLabel()} · <a href="/methodology">How we calculate this →</a></p>
    <nav class="rk-nav" aria-label="Rankings">
      {RANKINGS.map((x) => (
        <a href={`/rankings/${x.slug}`} style={`--rk:${x.accent}`} aria-current={x.slug === r.slug ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={x.icon} /></svg>{x.short}</a>
      ))}
    </nav>
  </section>

  {
    rows.length >= 3 && (
      <div class="rk-podium section" style={`--rk:${r.accent}`}>
        {[1, 0, 2].map((i) => {
          const x = rows[i];
          const [big, unit] = r.stat(x);
          return (
            <a class={`rk-pod p${i + 1}`} href={link(x)}>
              <div class="rk-pod-img">{x.photo ? <img src={`/photos/${x.photo}`} alt="" loading={i ? 'lazy' : 'eager'} decoding="async" /> : <span>🚗</span>}<span class="rk-medal">{i + 1}</span></div>
              <b>{nm(x)}</b>
              <span class="rk-big">{big}</span>
              <small>{unit}</small>
            </a>
          );
        })}
      </div>
    )
  }

  {
    rows.length ? (
      <ol class="rk-list section" style={`--rk:${r.accent}`}>
        {rows.map((x, i) => {
          const [big, unit] = r.stat(x);
          const w = bar(x);
          return (
            <li>
              <a href={link(x)}>
                <span class={`rk-n${i < 3 ? ' top' : ''}`}>{i + 1}</span>
                {x.photo ? <img src={`/photos/${x.photo}`} alt="" loading="lazy" decoding="async" /> : <i />}
                <span class="rk-name"><b>{nm(x)}</b>{sub(x) && <small>{sub(x)}</small>}</span>
                <span class="rk-val">
                  <span><b>{big}</b> <small>{unit}</small></span>
                  {w != null && <span class="rk-bar"><i style={`width:${w}%`} /></span>}
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    ) : (
      <p class="muted section">No data for this ranking yet.</p>
    )
  }
  {(readout.length > 0 || r.how) && <section class="section overview">{readout.map((p) => <p>{p}</p>)}{r.how && <p><b>How to use this list:</b> {r.how}</p>}</section>}
  <Ad place="bottom" />
</Base>
