---
import Base from '@/layouts/Base.astro';
import Ad from '@/components/Ad.astro';
import { type Model, type VsPair, campaigns, href, model as loadModel, n, usd, vsPairs } from '@/lib/data';
import { classNoun, describeYear } from '@/lib/describe';
import { prosCons } from '@/lib/proscons';

export function getStaticPaths() {
  return vsPairs().map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props as { p: VsPair };
const A = loadModel(...p.a) as Model;
const B = loadModel(...p.b) as Model;
// the same model year for both: newest year both have, this year or earlier first (next-year data is thin early on)
const now = new Date().getUTCFullYear();
const common = A.years.filter((y) => y.page && B.years.some((x) => x.page && x.year === y.year)).map((y) => y.year);
const year = common.find((y) => y <= now) ?? common[0];
const pickYear = (m: Model) => m.years.find((y) => y.page && y.year === year) ?? m.years.find((y) => y.page && y.year <= now + 1)!;
const ya = pickYear(A);
const yb = pickYear(B);
const na = `${A.make} ${A.model}`;
const nb = `${B.make} ${B.model}`;
const allRecalls = (m: Model) => new Set(m.years.flatMap((y) => y.recalls)).size;
const dim = (y: typeof ya, f: 'length' | 'width' | 'height' | 'weight') => {
  const v = y.dims.map((d) => d[f]).filter((x): x is number => !!x);
  return v.length ? Math.min(...v) : undefined;
};
const hp = (y: typeof ya) => y.specs?.hp?.[1];
const seats = (y: typeof ya) => y.specs?.seats?.[1];
const stdTech = (y: typeof ya) => Object.values(y.specs?.features ?? {}).filter((v) => v === 'std').length || undefined;
type Row = { g: number; label: string; a?: number; b?: number; fmt: (v: number) => string; better?: 'high' | 'low' };
const rows: Row[] = [
  { g: 0, label: 'Best combined MPG', a: ya.mpg?.max, b: yb.mpg?.max, fmt: (v) => `${v} MPG`, better: 'high' },
  { g: 0, label: 'City / highway MPG (best)', a: ya.mpg?.city, b: yb.mpg?.city, fmt: (v) => `${v} city` },
  { g: 0, label: 'EV range', a: ya.range, b: yb.range, fmt: (v) => `${v} mi`, better: 'high' },
  { g: 0, label: 'Fuel cost per year (EPA)', a: ya.cost, b: yb.cost, fmt: usd, better: 'low' },
  { g: 1, label: 'Horsepower (most powerful)', a: hp(ya), b: hp(yb), fmt: (v) => `${v} hp`, better: 'high' },
  { g: 1, label: 'Seats (most)', a: seats(ya), b: seats(yb), fmt: (v) => String(v) },
  { g: 2, label: 'NHTSA overall rating', a: ya.overall, b: yb.overall, fmt: (v) => '★'.repeat(v), better: 'high' },
  { g: 2, label: 'Driver-assist features standard', a: stdTech(ya), b: stdTech(yb), fmt: (v) => String(v), better: 'high' },
  { g: 1, label: 'Length', a: dim(ya, 'length'), b: dim(yb, 'length'), fmt: (v) => `${v} in` },
  { g: 1, label: 'Width', a: dim(ya, 'width'), b: dim(yb, 'width'), fmt: (v) => `${v} in` },
  { g: 1, label: 'Height', a: dim(ya, 'height'), b: dim(yb, 'height'), fmt: (v) => `${v} in` },
  { g: 1, label: 'Curb weight (lightest)', a: dim(ya, 'weight'), b: dim(yb, 'weight'), fmt: (v) => `${n(Math.round(v))} lb` },
  { g: 2, label: `Recalls (${ya.year === yb.year ? ya.year : 'latest year'})`, a: ya.recalls.length, b: yb.recalls.length, fmt: (v) => String(v), better: 'low' },
  { g: 2, label: 'Recalls, all years since 2005', a: allRecalls(A), b: allRecalls(B), fmt: (v) => String(v), better: 'low' },
  { g: 2, label: 'Owner complaints (latest year)', a: ya.complaints.total, b: yb.complaints.total, fmt: n, better: 'low' },
  { g: 3, label: 'Wikipedia views, 30 days', a: A.popularity?.views30, b: B.popularity?.views30, fmt: n },
];
const GROUPS = ['Efficiency', 'Performance & space', 'Safety & reliability', 'Interest'];
const bar = (r: Row, v?: number) => (v == null ? 0 : Math.max(4, (v / (Math.max(r.a ?? 0, r.b ?? 0) || 1)) * 100));
const win = (r: Row, side: 'a' | 'b') => {
  if (!r.better || r.a == null || r.b == null || r.a === r.b) return false;
  const mine = side === 'a' ? r.a : r.b, other = side === 'a' ? r.b : r.a;
  return r.better === 'high' ? mine > other : mine < other;
};
// plain-English summary from the rows that have a winner
const say: string[] = [];
const mpgRow = rows[0];
if (mpgRow.a && mpgRow.b && mpgRow.a !== mpgRow.b) say.push(`The ${mpgRow.a > mpgRow.b ? na : nb} is more fuel-efficient: ${Math.max(mpgRow.a, mpgRow.b)} vs ${Math.min(mpgRow.a, mpgRow.b)} MPG combined in its best version.`);
if (ya.cost && yb.cost && ya.cost !== yb.cost) say.push(`That works out to about ${usd(Math.abs(ya.cost - yb.cost))} a year less in fuel for the ${ya.cost < yb.cost ? na : nb} (EPA estimate, 15,000 miles).`);
const la = dim(ya, 'length'), lb = dim(yb, 'length');
if (la && lb && Math.abs(la - lb) >= 2) say.push(`The ${la > lb ? na : nb} is the bigger car, about ${Math.round(Math.abs(la - lb))} inches longer.`);
if (ya.overall && yb.overall && ya.overall !== yb.overall) say.push(`In NHTSA crash tests the ${ya.overall > yb.overall ? na : nb} scores higher overall (${Math.max(ya.overall, yb.overall)} vs ${Math.min(ya.overall, yb.overall)} stars).`);
else if (ya.overall && ya.overall === yb.overall) say.push(`Both earned ${ya.overall} stars overall in NHTSA crash tests.`);
const ra = allRecalls(A), rb = allRecalls(B);
if (ra !== rb) say.push(`Across all model years since 2005, the ${ra < rb ? na : nb} has had fewer recall campaigns (${Math.min(ra, rb)} vs ${Math.max(ra, rb)}).`);
// specs from vPIC (when decoded) and each car's pros & cons
const C = campaigns();
const pcA = prosCons(A, ya, ya.recalls.map((id) => C[id]).filter(Boolean));
const pcB = prosCons(B, yb, yb.recalls.map((id) => C[id]).filter(Boolean));
// "choose X if…": every clear advantage, in plain words
const awd = (y: typeof ya) => y.drives.some((d) => /4-Wheel|All-Wheel|4WD|AWD|Part-time/i.test(d));
const hybrid = (y: typeof ya) => y.fuels.some((f) => /Hybrid|EV/.test(f));
function reasons(me: typeof ya, other: typeof ya, mine: Model, theirs: Model) {
  const r: string[] = [];
  if (me.mpg && other.mpg && me.mpg.max - other.mpg.max >= 2) r.push(`you want lower fuel bills (${me.mpg.max} vs ${other.mpg.max} MPG)`);
  if (me.range && (!other.range || me.range - other.range >= 20)) r.push(`you want an EV with more range (${me.range} miles)`);
  if (hp(me) && hp(other) && hp(me)! >= hp(other)! * 1.1) r.push(`you want more power (up to ${hp(me)} vs ${hp(other)} hp)`);
  if (seats(me) && seats(other) && seats(me)! > seats(other)!) r.push(`you need more seats (${seats(me)} vs ${seats(other)})`);
  const lm = dim(me, 'length'), lo = dim(other, 'length');
  if (lm && lo && lo - lm >= 3) r.push(`you want something easier to park (${Math.round(lo - lm)} in shorter)`);
  if (lm && lo && lm - lo >= 3) r.push(`you want more room (${Math.round(lm - lo)} in longer)`);
  if (awd(me) && !awd(other)) r.push('you need AWD or 4WD');
  if (hybrid(me) && !hybrid(other)) r.push('you want a hybrid or electric option');
  if (me.overall && other.overall && me.overall > other.overall) r.push(`crash-test stars matter most (${me.overall} vs ${other.overall})`);
  if (stdTech(me) && stdTech(other) && stdTech(me)! - stdTech(other)! >= 2) r.push('you want more standard driver-assist tech');
  const rm = allRecalls(mine), rt = allRecalls(theirs);
  if (rt - rm >= 5) r.push(`you put reliability history first (${rm} vs ${rt} recalls since 2005)`);
  return r;
}
const whyA = reasons(ya, yb, A, B);
const whyB = reasons(yb, ya, B, A);
const winsA = rows.filter((r) => win(r, 'a')).length;
const winsB = rows.filter((r) => win(r, 'b')).length;
const contests = winsA + winsB;
const desc = `${na} vs ${nb}: fuel economy, size, safety ratings, recalls and owner complaints compared side by side for the ${ya.year} models${A.verdict && B.verdict ? ', plus the best years to buy used' : ''}.`;
---

<Base title={`${na} vs ${nb}: MPG, Size, Safety & Reliability`} description={desc} section="compare">
  <div class="crumbs"><a href="/compare">Compare</a></div>
  <h1>{na} vs {nb}</h1>
  <p class="lead">{ya.year} {na} vs {yb.year} {nb} — {classNoun(ya.cls) === classNoun(yb.cls) ? `two ${classNoun(ya.cls)}s` : 'two rivals'} compared on efficiency, size, safety and reliability.</p>

  <div class="cmp-heads section">
    {[[A, ya, na], null, [B, yb, nb]].map((c) =>
      c ? (
        <div class="cmp-car">
          <div class="cmp-photo">{(c[0] as Model).photo ? <img src={`/photos/${(c[0] as Model).photo!.file}`} alt={c[2] as string} /> : <span>🚗</span>}</div>
          <h2><a href={href(c[0] as Model, (c[1] as typeof ya).year)}>{(c[1] as typeof ya).year} {c[2] as string}</a></h2>
          <div class="cmp-tags"><span>{(c[1] as typeof ya).cls}</span>{awd(c[1] as typeof ya) && <span>AWD/4WD</span>}{hybrid(c[1] as typeof ya) && <span>Hybrid/EV</span>}</div>
        </div>
      ) : (
        <div class="cmp-score"><span class="vs-badge big">VS</span><b>{winsA} – {winsB}</b><small>{winsA === winsB ? `Tie: ${winsA} categories each` : `${winsA > winsB ? na : nb} wins ${Math.max(winsA, winsB)} of ${contests} categories`}</small></div>
      ),
    )}
  </div>
  <p class="small" style="text-align:center"><a href={`/compare?a=${p.a.join('/')}&b=${p.b.join('/')}`}>Swap in a different car →</a></p>

  {say.length > 0 && (<section class="section overview"><h2 style="margin-bottom:10px">The short version</h2>{say.map((s) => <p>{s}</p>)}</section>)}
  <section class="section overview"><h2 style="margin-bottom:10px">The two cars</h2><p>{describeYear(A, ya).slice(0, 2).join(' ')}</p><p>{describeYear(B, yb).slice(0, 2).join(' ')}</p>{A.verdict && B.verdict && <p>Buying used? The {A.verdict.best.year} {A.model} and the {B.verdict.best.year} {B.model} have the fewest problems in our data{A.verdict.worst || B.verdict.worst ? `; avoid ${[A.verdict.worst && `the ${A.verdict.worst.year} ${A.model}`, B.verdict.worst && `the ${B.verdict.worst.year} ${B.model}`].filter(Boolean).join(' and ')}` : ''}.</p>}</section>

  <section class="section">
    <div class="cmp-group">
      <h3>Basics</h3>
      {[['Class', ya.cls, yb.cls], ['Fuel', ya.fuels.join(', '), yb.fuels.join(', ')], ['Engines', ya.engines.join(', ') || ya.fuels.join(', '), yb.engines.join(', ') || yb.fuels.join(', ')], ['Drivetrain', ya.drives.join(', '), yb.drives.join(', ')]].map(([l, a, b]) => (
        <div class="cmp-row text"><div class="cmp-val left"><span>{a || '–'}</span></div><div class="cmp-label">{l}</div><div class="cmp-val right"><span>{b || '–'}</span></div></div>
      ))}
    </div>
    {GROUPS.map((title, gi) => {
      const list = rows.filter((r) => r.g === gi && (r.a != null || r.b != null));
      return list.length > 0 && (
        <div class="cmp-group">
          <h3>{title}</h3>
          {list.map((r) => (
            <div class="cmp-row">
              <div class:list={['cmp-val left', { win: win(r, 'a') }]}><span>{r.a == null ? '–' : r.fmt(r.a)}</span><i style={`width:${bar(r, r.a)}%`} /></div>
              <div class="cmp-label">{r.label}</div>
              <div class:list={['cmp-val right', { win: win(r, 'b') }]}><i style={`width:${bar(r, r.b)}%`} /><span>{r.b == null ? '–' : r.fmt(r.b)}</span></div>
            </div>
          ))}
        </div>
      );
    })}
    <div class="cmp-group">
      <h3>Buying used</h3>
      <div class="cmp-row text"><div class="cmp-val left"><span>{A.verdict ? <a href={href(A, A.verdict.best.year)}>{A.verdict.best.year}</a> : '–'}</span></div><div class="cmp-label">Best used year</div><div class="cmp-val right"><span>{B.verdict ? <a href={href(B, B.verdict.best.year)}>{B.verdict.best.year}</a> : '–'}</span></div></div>
      <div class="cmp-row text"><div class="cmp-val left"><span>{A.verdict?.worst ? <a href={href(A, A.verdict.worst.year)}>{A.verdict.worst.year}</a> : '–'}</span></div><div class="cmp-label">Year to avoid</div><div class="cmp-val right"><span>{B.verdict?.worst ? <a href={href(B, B.verdict.worst.year)}>{B.verdict.worst.year}</a> : '–'}</span></div></div>
    </div>
    <p class="small muted">Green = clearly better. Prices are not included. <a href="/methodology">How we calculate this →</a></p>
  </section>

  {
    (whyA.length > 0 || whyB.length > 0) && (
      <section class="section">
        <div class="section-head"><h2>Which one should you choose?</h2></div>
        <div class="pc-grid">
          <div class="pc pros"><h3>Choose the {na} if…</h3>{whyA.length ? <ul>{whyA.map((w) => <li><b>{w[0].toUpperCase() + w.slice(1)}</b></li>)}</ul> : <p class="muted small">It doesn't clearly beat the {nb} on any measure we track.</p>}</div>
          <div class="pc pros"><h3>Choose the {nb} if…</h3>{whyB.length ? <ul>{whyB.map((w) => <li><b>{w[0].toUpperCase() + w.slice(1)}</b></li>)}</ul> : <p class="muted small">It doesn't clearly beat the {na} on any measure we track.</p>}</div>
        </div>
      </section>
    )
  }

  {
    [pcA, pcB].some((p) => p.pros.length || p.cons.length) && (
      <section class="section">
        <div class="section-head"><h2>Pros &amp; cons of each</h2></div>
        <div class="pc-grid">
          {[[na, ya, pcA], [nb, yb, pcB]].map(([nm, y, pc]) => (
            <div class="pc"><h3>{(y as typeof ya).year} {nm as string}</h3>
              <ul>
                {(pc as typeof pcA).pros.map((p) => <li><b>{p.title}</b>{p.detail && <span>{p.detail}</span>}</li>)}
                {(pc as typeof pcA).cons.map((p) => <li class="minus"><b>{p.title}</b>{p.detail && <span>{p.detail}</span>}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <Ad place="content" />
  <p class="chips section"><a href={href(A, ya.year)}>Full {ya.year} {na} specs →</a><a href={href(B, yb.year)}>Full {yb.year} {nb} specs →</a><a href={`/tools/fuel-cost?a=${encodeURIComponent(`${ya.year} ${na}`)}&b=${encodeURIComponent(`${yb.year} ${nb}`)}`}>Compare fuel costs for your driving →</a><a href={`/tools/garage-fit?a=${encodeURIComponent(na)}&b=${encodeURIComponent(nb)}`}>Compare size &amp; garage fit →</a></p>
  <Ad place="bottom" />
</Base>
