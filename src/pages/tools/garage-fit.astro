---
import Base from '@/layouts/Base.astro';
import Ad from '@/components/Ad.astro';
---

<Base title="Will It Fit My Garage? Car Size Comparison Tool" description="Check whether a car, truck or SUV fits your garage and garage door, with space left to walk around and open the doors — and compare the length, width and height of up to three vehicles." section="tools">
  <div class="crumbs"><a href="/tools">Tools</a></div>
  <h1>Garage fit &amp; size comparison</h1>
  <p class="lead">Measure your garage once, then see how much room each car leaves to walk around and open the doors.</p>

  <div class="tool-grid section">
    <form class="card form" id="gf" onsubmit="return false">
      <div class="presets small">
        <span class="muted">Typical:</span>
        <button type="button" class="chip" data-p="264,144,108,84">1-car</button>
        <button type="button" class="chip" data-p="264,240,192,84">2-car</button>
        <button type="button" class="chip" data-p="240,216,192,84">Small 2-car</button>
      </div>
      <label>Garage inside length (in)<input name="gl" type="number" min="120" step="1" value="264" /></label>
      <label>Garage inside width (in)<input name="gw" type="number" min="72" step="1" value="240" /></label>
      <label>Door opening width (in)<input name="dw" type="number" min="72" step="1" value="192" /></label>
      <label>Door opening height (in)<input name="dh" type="number" min="72" step="1" value="84" /></label>
      <label style="grid-column:1/-1">Car 1<input name="c1" list="cars" placeholder="e.g. Ford F-150" /></label>
      <label style="grid-column:1/-1">Car 2 (optional)<input name="c2" list="cars" placeholder="e.g. Honda CR-V" /></label>
      <label style="grid-column:1/-1">Car 3 (optional)<input name="c3" list="cars" placeholder="e.g. Toyota Camry" /></label>
      <label class="check" style="grid-column:1/-1"><input type="checkbox" name="side" /> Park cars 1 and 2 side by side</label>
      <datalist id="cars"></datalist>
    </form>
    <div id="out" aria-live="polite"></div>
  </div>

  <section class="section">
    <div class="section-head"><h2>Size comparison</h2></div>
    <div id="cmp"></div>
  </section>

  <section class="section prose">
    <h2>How much room do you need?</h2>
    <ul>
      <li><b>Length:</b> about 2–3 ft (24–36 in) in front or behind to walk past, more if there is a workbench or storage.</li>
      <li><b>Width:</b> about 2.5 ft (30 in) on the driver's side to open a door and get out comfortably; 2 ft is tight.</li>
      <li><b>Door:</b> mirrors stick out further than the body. Widths here are body widths <b>without mirrors</b>, so we add {'9'} in for them at the garage door.</li>
      <li><b>Height:</b> standard garage doors are 7 ft (84 in) tall. Roof racks, roof boxes and lift kits add height.</li>
    </ul>
    <p class="small muted">Dimensions: Transport Canada Canadian Vehicle Specifications (Open Government Licence – Canada) for the largest body style of the newest model year we have. Always measure your own garage and the actual vehicle.</p>
  </section>
  <Ad place="bottom" />
</Base>

<script>
  type Row = { mk: string; md: string; ms: string; s: string; y: number; len?: number; wd?: number; ht?: number; wb?: number; dy?: number; pop: number };
  const MIRRORS = 9; // body width → width across the mirrors, roughly
  const form = document.getElementById('gf') as HTMLFormElement;
  const out = document.getElementById('out')!;
  const cmp = document.getElementById('cmp')!;
  const esc = (s = '') => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const ftin = (v: number) => {
    const s = v < 0 ? '−' : '';
    const a = Math.abs(Math.round(v));
    return a >= 12 ? `${s}${Math.floor(a / 12)} ft ${a % 12} in` : `${s}${a} in`;
  };
  let byName = new Map<string, Row>();
  const COLORS = ['var(--brand)', 'var(--accent-2)', 'var(--accent-3)'];

  function verdict(ok: boolean, tight: boolean) {
    return ok ? (tight ? '<span class="badge warn">Tight</span>' : '<span class="badge good">Fits</span>') : '<span class="badge bad">Too big</span>';
  }

  function render() {
    const f = new FormData(form);
    const g = { l: +f.get('gl')!, w: +f.get('gw')!, dw: +f.get('dw')!, dh: +f.get('dh')! };
    const cars = ['c1', 'c2', 'c3'].map((k) => byName.get(String(f.get(k)))).filter((r): r is Row => !!r?.len);
    if (!cars.length) {
      out.innerHTML = '<div class="result-card"><p class="muted">Pick a car to check it against your garage.</p></div>';
      cmp.innerHTML = '';
      return;
    }
    const side = !!f.get('side') && cars.length >= 2;
    // top-down drawing, 1 in = s px
    const s = 300 / Math.max(g.l, g.w);
    const W = g.w * s, L = g.l * s;
    let shapes = '';
    const placed = side ? cars.slice(0, 2) : [cars[0]];
    const gap = side ? (g.w - placed[0].wd! - placed[1].wd!) / 3 : (g.w - placed[0].wd!) / 2;
    let x = gap;
    placed.forEach((c, i) => {
      shapes += `<rect x="${x * s}" y="${(g.l - c.len!) / 2 * s}" width="${c.wd! * s}" height="${c.len! * s}" rx="${8 * s}" fill="${COLORS[i]}" fill-opacity=".85"/><text x="${(x + c.wd! / 2) * s}" y="${g.l / 2 * s}" text-anchor="middle" dominant-baseline="middle" class="svg-label">${esc(c.md)}</text>`;
      x += c.wd! + gap;
    });
    const doorX = (g.w - g.dw) / 2 * s;
    const svg = `<svg viewBox="-12 -12 ${W + 24} ${L + 30}" class="garage-svg" role="img" aria-label="Top view of the garage">
      <rect x="0" y="0" width="${W}" height="${L}" class="g-wall"/>
      <line x1="${doorX}" y1="${L}" x2="${doorX + g.dw * s}" y2="${L}" class="g-door"/>
      ${shapes}
      <text x="${W / 2}" y="${L + 14}" text-anchor="middle" class="svg-note">garage door</text></svg>`;

    const rows = cars.map((c, i) => {
      const lenLeft = g.l - c.len!;
      const sideLeft = side && i < 2 ? gap : (g.w - c.wd!) / 2;
      const doorLeft = (g.dw - c.wd! - MIRRORS) / 2;
      const hLeft = g.dh - c.ht!;
      const ok = lenLeft > 0 && sideLeft > 0 && doorLeft > 0 && hLeft > 0;
      const tight = lenLeft < 36 || sideLeft < 30 || doorLeft < 6 || hLeft < 4;
      return `<div class="fit-row"><div class="fit-head"><i class="dot" style="background:${COLORS[i]}"></i><a href="/${c.ms}/${c.s}/${c.dy ?? c.y}">${c.dy ?? c.y} ${esc(c.mk)} ${esc(c.md)}</a> ${verdict(ok, tight)}</div>
        <dl class="facts compact">
          <dt>Front + back space</dt><dd class="${lenLeft < 0 ? 'neg' : lenLeft < 36 ? 'warn' : ''}">${ftin(lenLeft)} total</dd>
          <dt>Space each side${side && i < 2 ? ' (between cars)' : ''}</dt><dd class="${sideLeft < 0 ? 'neg' : sideLeft < 30 ? 'warn' : ''}">${ftin(sideLeft)}</dd>
          <dt>Door, each side (with mirrors)</dt><dd class="${doorLeft < 0 ? 'neg' : doorLeft < 6 ? 'warn' : ''}">${ftin(doorLeft)}</dd>
          <dt>Headroom under door</dt><dd class="${hLeft < 0 ? 'neg' : hLeft < 4 ? 'warn' : ''}">${ftin(hLeft)}</dd>
        </dl></div>`;
    });
    out.innerHTML = `<div class="result-card garage">${svg}${rows.join('')}</div>`;

    // size comparison: table + side-view silhouettes to scale
    const maxL = Math.max(...cars.map((c) => c.len!));
    const sv = 560 / maxL;
    const maxH = Math.max(...cars.map((c) => c.ht!));
    const side_svg = `<svg viewBox="0 0 580 ${maxH * sv + 20}" class="size-svg" role="img" aria-label="Side view outlines to scale">${cars
      .map((c, i) => `<rect x="10" y="${(maxH - c.ht!) * sv + 10}" width="${c.len! * sv}" height="${c.ht! * sv}" rx="${10 * sv}" fill="none" stroke="${COLORS[i]}" stroke-width="2.5"/>`)
      .join('')}</svg>`;
    const fmt = (v?: number) => (v ? `${v.toFixed(1)} in` : '–');
    const rowsT = [
      ['Length', (c: Row) => fmt(c.len)],
      ['Width (no mirrors)', (c: Row) => fmt(c.wd)],
      ['Height', (c: Row) => fmt(c.ht)],
      ['Wheelbase', (c: Row) => fmt(c.wb)],
    ] as const;
    cmp.innerHTML = `<div class="card">${side_svg}<p class="small muted" style="margin:6px 0 0">Side-view outlines to scale (boxes, not the real shape).</p></div>
      <div class="table-wrap" style="margin-top:12px"><table><thead><tr><th></th>${cars.map((c, i) => `<th><i class="dot" style="background:${COLORS[i]}"></i> ${c.dy ?? c.y} ${esc(c.md)}</th>`).join('')}</tr></thead>
      <tbody>${rowsT.map(([k, fn]) => `<tr><td>${k}</td>${cars.map((c) => `<td>${fn(c)}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;
  }

  form.addEventListener('input', render);
  form.querySelectorAll<HTMLButtonElement>('[data-p]').forEach((b) =>
    b.addEventListener('click', () => {
      const [gl, gw, dw, dh] = b.dataset.p!.split(',');
      Object.entries({ gl, gw, dw, dh }).forEach(([k, v]) => ((form.elements.namedItem(k) as HTMLInputElement).value = v));
      render();
    }),
  );
  fetch('/finder-data.json')
    .then((r) => r.json())
    .then((d) => {
      const rows: Row[] = d.rows.filter((r: Row) => r.len && r.wd && r.ht).sort((p: Row, q: Row) => q.pop - p.pop);
      byName = new Map(rows.map((r) => [`${r.mk} ${r.md}`, r]));
      document.getElementById('cars')!.innerHTML = rows.map((r) => `<option value="${esc(`${r.mk} ${r.md}`)}">`).join('');
      const p = new URLSearchParams(location.search);
      (form.elements.namedItem('c1') as HTMLInputElement).value = p.get('a') ?? 'Ford F-150';
      (form.elements.namedItem('c2') as HTMLInputElement).value = p.get('b') ?? 'Honda CR-V';
      render();
    });
</script>
