---
import Base from '@/layouts/Base.astro';
import Ad from '@/components/Ad.astro';
import { VIN_LOOKUP } from '@/config/site';
---

<Base title="Free VIN Decoder: Year, Engine, Plant & Recall Check" description="Decode any 17-character VIN for free: model year, make, model, trim, engine, horsepower, transmission and where it was built — then check recalls and known problems." section="tools">
  <div class="crumbs"><a href="/tools">Tools</a></div>
  <h1>VIN decoder</h1>
  <p class="lead">Enter a 17-character Vehicle Identification Number to see what the car really is — then jump to its recalls, problems and specs.</p>

  <form class="card form section" id="vf">
    <label style="grid-column:1/-1">VIN
      <input name="vin" id="vin" maxlength="17" autocomplete="off" spellcheck="false" placeholder="e.g. 1HGCV1F30LA000000" style="font-family:ui-monospace,monospace;text-transform:uppercase;letter-spacing:.06em" />
    </label>
    <div><button class="btn" type="submit">Decode VIN</button></div>
  </form>
  <p id="msg" class="small muted" aria-live="polite">The VIN is sent directly from your browser to NHTSA's free vPIC decoder. CarRadar does not receive or store it.</p>
  <div id="res"></div>

  <section class="section prose">
    <h2>Where to find the VIN</h2>
    <p>Look through the windshield at the lower driver-side corner, on the sticker in the driver's door jamb, or on the registration, title or insurance card. VINs never contain the letters I, O or Q.</p>
    <h2>Decoding is not a recall check</h2>
    <p>A decoder tells you how the car was built. To see whether it has an <b>open</b> recall, enter the same VIN at <a href={VIN_LOOKUP} target="_blank" rel="noopener">nhtsa.gov/recalls</a>.</p>
  </section>
  <Ad place="bottom" />
</Base>

<script define:vars={{ VIN_LOOKUP }}>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  const norm = (s) => String(s ?? '').toUpperCase().replace(/[^A-Z0-9]/g, '');
  let rows = null;

  function findPage(make, model, year) {
    const mk = norm(make).replace(/^MERCEDES$/, 'MERCEDESBENZ');
    const md = norm(model);
    const same = rows.filter((r) => norm(r.mk) === mk);
    const hit = same.find((r) => norm(r.md) === md) ?? same.sort((a, b) => norm(b.md).length - norm(a.md).length).find((r) => md.startsWith(norm(r.md)) || norm(r.md).startsWith(md));
    if (!hit) return null;
    return { model: `/${hit.ms}/${hit.s}`, year: hit.years.includes(Number(year)) ? `/${hit.ms}/${hit.s}/${year}` : null, name: `${hit.mk} ${hit.md}` };
  }

  $('vf').addEventListener('submit', async (e) => {
    e.preventDefault();
    const vin = $('vin').value.trim().toUpperCase();
    if (!/^[A-HJ-NPR-Z0-9]{17}$/.test(vin)) {
      $('msg').textContent = 'A VIN has exactly 17 letters and numbers, without I, O or Q.';
      return;
    }
    $('msg').textContent = 'Decoding…';
    try {
      const [d, data] = await Promise.all([
        fetch(`https://vpic.nhtsa.dot.gov/api/vehicles/DecodeVinValues/${vin}?format=json`).then((r) => r.json()),
        rows ? Promise.resolve(null) : fetch('/finder-data.json').then((r) => r.json()),
      ]);
      if (data) rows = data.rows;
      const x = d.Results?.[0] ?? {};
      if (!x.Make) {
        $('msg').textContent = 'NHTSA could not decode this VIN. Check it for typos.';
        $('res').innerHTML = '';
        return;
      }
      const eng = [x.DisplacementL && `${(+x.DisplacementL).toFixed(1)}L`, x.EngineCylinders && `${x.EngineCylinders}-cyl`, x.EngineConfiguration, x.EngineHP && `${Math.round(+x.EngineHP)} hp`, x.Turbo === 'Yes' && 'turbo'].filter(Boolean).join(' ');
      const facts = [
        ['Model year', x.ModelYear], ['Make', x.Make], ['Model', x.Model], ['Trim', [x.Trim, x.Series].filter(Boolean).join(' ')], ['Body', x.BodyClass], ['Doors', x.Doors],
        ['Engine', eng], ['Fuel', [x.FuelTypePrimary, x.ElectrificationLevel].filter(Boolean).join(' · ')], ['Drive', x.DriveType], ['Transmission', [x.TransmissionStyle, x.TransmissionSpeeds && `${x.TransmissionSpeeds}-speed`].filter(Boolean).join(' ')],
        ['Built in', [x.PlantCity, x.PlantState, x.PlantCountry].filter(Boolean).join(', ')], ['Manufacturer', x.Manufacturer],
      ].filter(([, v]) => v && String(v).trim());
      const page = findPage(x.Make, x.Model, x.ModelYear);
      const warn = x.ErrorCode && x.ErrorCode !== '0' ? `<p class="note">NHTSA note: ${esc(x.ErrorText)}</p>` : '';
      $('res').innerHTML = `<div class="hero" style="margin-top:0"><dl class="facts">${facts.map(([k, v]) => `<dt>${esc(k)}</dt><dd>${esc(v)}</dd>`).join('')}</dl><div class="card">
        <h2 style="font-size:1.1rem">Next steps</h2>
        <p><a class="cta" href="${VIN_LOOKUP}" target="_blank" rel="noopener">Check open recalls for this VIN at NHTSA ↗</a></p>
        ${page ? `<p>${page.year ? `<a href="${page.year}"><b>${esc(x.ModelYear)} ${esc(page.name)}</b>: recalls, problems &amp; buyer checklist →</a><br>` : ''}<a href="${page.model}">All ${esc(page.name)} years: best &amp; worst to buy →</a></p>` : '<p class="small muted">We don\'t have a page for this model yet.</p>'}
      </div></div>${warn}`;
      $('msg').textContent = '';
    } catch (err) {
      $('msg').textContent = 'The NHTSA decoder did not respond. Please try again in a moment.';
    }
  });
</script>
