---
import Base from '@/layouts/Base.astro';
import Ad from '@/components/Ad.astro';
import { fuelPrices } from '@/lib/data';
const P = fuelPrices();
---

<Base title="Fuel Cost Calculator: Gas vs Hybrid vs Electric" description="Compare the yearly and 5-year fuel or charging cost of any two cars for your own mileage and local prices, and see how long a hybrid or EV takes to pay back." section="tools">
  <div class="crumbs"><a href="/tools">Tools</a></div>
  <h1>Fuel cost calculator</h1>
  <p class="lead">Gas vs hybrid vs electric: what will each car really cost you to fuel? Pick two cars and enter your own driving.</p>

  <form class="card form section" id="cf" onsubmit="return false">
    <label>Car A<input name="a" list="cars" placeholder="Start typing, e.g. Toyota Camry" /></label>
    <label>Car B<input name="b" list="cars" placeholder="e.g. Tesla Model 3" /></label>
    <label>Miles per year<input name="miles" type="number" min="1000" step="500" value="13500" /></label>
    <label>Gas price ($/gal)<input name="gas" type="number" step="0.01" value={P.regular ?? '3.50'} /></label>
    <label>Premium ($/gal)<input name="prem" type="number" step="0.01" value={P.premium ?? '4.30'} /></label>
    <label>Electricity ($/kWh)<input name="kwh" type="number" step="0.01" value={P.electric ?? '0.17'} /></label>
    <label>Years<input name="years" type="number" min="1" max="15" value="5" /></label>
    <label>Price difference, optional ($)<input name="diff" type="number" step="100" placeholder="how much more the efficient car costs" /></label>
    <datalist id="cars"></datalist>
  </form>
  <div id="out" class="section"></div>
  <p class="small muted">Default prices are the U.S. averages used by fueleconomy.gov (EPA/DOE). Efficiency is the EPA combined rating of each model's most efficient latest-year version; plug-in hybrids are counted on gasoline only. Home charging only — public fast charging usually costs more.</p>
  <Ad place="bottom" />
</Base>

<script>
  type Row = { mk: string; md: string; ms: string; s: string; y: number; gal?: number; premium?: boolean; kwh?: number; pw: string; pop: number };
  const form = document.getElementById('cf') as HTMLFormElement;
  const out = document.getElementById('out')!;
  const usd = (v: number) => `$${Math.round(v).toLocaleString('en-US')}`;
  const esc = (s = '') => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  let byName = new Map<string, Row>();

  function cost(r: Row, f: FormData) {
    const miles = +(f.get('miles') ?? 0);
    if (r.kwh && (!r.gal || r.pw === 'Electric')) return { per100: (r.kwh * +(f.get('kwh') ?? 0)), unit: `${Math.round(r.kwh * 10) / 10} kWh/100 mi`, year: (miles / 100) * r.kwh * +(f.get('kwh') ?? 0) };
    if (r.gal) {
      const price = r.premium ? +(f.get('prem') ?? 0) : +(f.get('gas') ?? 0);
      return { per100: r.gal * price, unit: `${Math.round(100 / r.gal)} MPG${r.premium ? ' (premium)' : ''}`, year: (miles / 100) * r.gal * price };
    }
    return null;
  }

  function render() {
    const f = new FormData(form);
    const a = byName.get(String(f.get('a'))), b = byName.get(String(f.get('b')));
    const picks = [a, b].filter(Boolean) as Row[];
    if (!picks.length) {
      out.innerHTML = '<p class="muted">Choose at least one car.</p>';
      return;
    }
    const years = Math.max(1, +(f.get('years') ?? 5));
    const res = picks.map((r) => ({ r, c: cost(r, f) }));
    let html = '<div class="grid">' + res.map(({ r, c }) => `<div class="card"><h3><a href="/${r.ms}/${r.s}/${r.y}" style="color:var(--brand);text-decoration:none">${r.y} ${esc(r.mk)} ${esc(r.md)}</a></h3>${c ? `<p class="small muted" style="margin:4px 0 8px">${c.unit}</p><div class="stats" style="margin-top:0"><div class="stat"><b>${usd(c.year)}</b><span>per year</span></div><div class="stat"><b>${usd(c.year * years)}</b><span>over ${years} years</span></div><div class="stat"><b>${(c.per100 / 100 * 100).toFixed(1)}¢</b><span>per mile</span></div></div>` : '<p class="muted">No EPA efficiency data.</p>'}</div>`).join('') + '</div>';
    if (res.length === 2 && res[0].c && res[1].c) {
      const [x, y] = res[0].c.year <= res[1].c.year ? [res[0], res[1]] : [res[1], res[0]];
      const save = y.c!.year - x.c!.year;
      const diff = +(f.get('diff') ?? 0);
      html += `<div class="note" style="margin-top:14px">The <b>${esc(x.r.mk)} ${esc(x.r.md)}</b> saves about <b>${usd(save)} a year</b> and <b>${usd(save * years)} over ${years} years</b>.${diff > 0 && save > 0 ? ` A ${usd(diff)} higher price would pay back in about <b>${(diff / save).toFixed(1)} years</b>.` : ''}</div>`;
    }
    out.innerHTML = html;
  }
  form.addEventListener('input', render);
  fetch('/finder-data.json')
    .then((r) => r.json())
    .then((d) => {
      const rows: Row[] = d.rows.filter((r: Row) => r.gal || r.kwh).sort((p: Row, q: Row) => q.pop - p.pop);
      byName = new Map(rows.map((r) => [`${r.y} ${r.mk} ${r.md}`, r]));
      document.getElementById('cars')!.innerHTML = rows.map((r) => `<option value="${esc(`${r.y} ${r.mk} ${r.md}`)}">`).join('');
      const params = new URLSearchParams(location.search);
      (form.elements.namedItem('a') as HTMLInputElement).value = params.get('a') ?? `${rows.find((r) => r.md === 'Camry')?.y ?? ''} Toyota Camry`.trim();
      (form.elements.namedItem('b') as HTMLInputElement).value = params.get('b') ?? `${rows.find((r) => r.md === 'Model 3')?.y ?? ''} Tesla Model 3`.trim();
      render();
    });
</script>
