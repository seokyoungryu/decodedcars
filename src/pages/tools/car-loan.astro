---
import Base from '@/layouts/Base.astro';
import Ad from '@/components/Ad.astro';
---

<Base title="Car Loan Calculator: Monthly Payment, Interest & Term" description="Free car loan calculator: monthly payment, total interest and total cost for any price, down payment, trade-in, sales tax, APR and loan term — plus how much car fits your monthly budget." section="tools">
  <div class="crumbs"><a href="/tools">Tools</a></div>
  <h1>Car loan calculator</h1>
  <p class="lead">See the monthly payment and what the loan really costs — then compare loan lengths side by side.</p>

  <div class="tool-grid section">
    <form class="card form" id="lf" onsubmit="return false">
      <div class="seg" role="tablist">
        <label><input type="radio" name="mode" value="pay" checked /> Payment for a price</label>
        <label><input type="radio" name="mode" value="budget" /> Price for a budget</label>
      </div>
      <label data-mode="pay">Vehicle price ($)<input name="price" type="number" min="0" step="500" value="35000" /></label>
      <label data-mode="budget" hidden>Monthly budget ($)<input name="budget" type="number" min="0" step="25" value="600" /></label>
      <label>Down payment ($)<input name="down" type="number" min="0" step="500" value="5000" /></label>
      <label>Trade-in value ($)<input name="trade" type="number" min="0" step="500" value="0" /></label>
      <label>Amount still owed on trade-in ($)<input name="owed" type="number" min="0" step="500" value="0" /></label>
      <label>Sales tax (%)<input name="tax" type="number" min="0" max="15" step="0.1" value="6" /></label>
      <label>Fees: title, registration, doc ($)<input name="fees" type="number" min="0" step="50" value="800" /></label>
      <label>APR (%)<input name="apr" type="number" min="0" max="40" step="0.1" value="7" /></label>
      <label>Loan term
        <select name="term">{[24, 36, 48, 60, 72, 84].map((t) => <option value={t} selected={t === 60}>{t} months ({t / 12} years)</option>)}</select>
      </label>
    </form>
    <div id="out" aria-live="polite"></div>
  </div>

  <section class="section">
    <div class="section-head"><h2>Same car, different loan lengths</h2></div>
    <div class="table-wrap"><table id="terms"></table></div>
    <p class="small muted">Longer loans lower the payment but cost more interest, and you can owe more than the car is worth for longer.</p>
  </section>

  <section class="section">
    <div class="section-head"><h2>Balance by year</h2></div>
    <div class="table-wrap"><table id="amort"></table></div>
  </section>

  <section class="section prose">
    <h2>How this is calculated</h2>
    <p>Amount financed = price + sales tax + fees − down payment − trade-in + any amount still owed on the trade-in. Sales tax is charged on the price minus the trade-in, as in most U.S. states (some states tax the full price). The payment uses the standard fixed-rate amortization formula with monthly compounding.</p>
    <p>The APR here is only an example — use the rate from your own pre-approval or the dealer's quote. Rates depend on your credit, the loan length and whether the car is new or used. This is an estimate, not a loan offer.</p>
  </section>
  <Ad place="bottom" />
</Base>

<script>
  const form = document.getElementById('lf') as HTMLFormElement;
  const out = document.getElementById('out')!;
  const usd = (v: number) => `$${Math.round(v).toLocaleString('en-US')}`;
  const num = (f: FormData, k: string) => Math.max(0, Number(f.get(k)) || 0);

  /** monthly payment for principal p, annual rate r (%), n months */
  const payment = (p: number, r: number, n: number) => (r === 0 ? p / n : (p * (r / 1200)) / (1 - (1 + r / 1200) ** -n));
  /** principal that a monthly payment pays off */
  const principalFor = (pay: number, r: number, n: number) => (r === 0 ? pay * n : (pay * (1 - (1 + r / 1200) ** -n)) / (r / 1200));

  /** amount financed for a vehicle price */
  function financed(price: number, f: FormData) {
    const taxable = Math.max(0, price - num(f, 'trade'));
    return Math.max(0, price + (taxable * num(f, 'tax')) / 100 + num(f, 'fees') - num(f, 'down') - num(f, 'trade') + num(f, 'owed'));
  }
  /** the price whose amount financed equals `p` (inverse of financed) */
  function priceFor(p: number, f: FormData) {
    const t = num(f, 'tax') / 100;
    const price = (p - num(f, 'fees') + num(f, 'down') + num(f, 'trade') - num(f, 'owed') + t * num(f, 'trade')) / (1 + t);
    return Math.max(0, price);
  }

  function render() {
    const f = new FormData(form);
    const mode = f.get('mode');
    form.querySelectorAll<HTMLElement>('[data-mode]').forEach((el) => (el.hidden = el.dataset.mode !== mode));
    const apr = num(f, 'apr'), n = Number(f.get('term'));
    let price: number, p: number, pay: number;
    if (mode === 'budget') {
      pay = num(f, 'budget');
      p = principalFor(pay, apr, n);
      price = priceFor(p, f);
    } else {
      price = num(f, 'price');
      p = financed(price, f);
      pay = payment(p, apr, n);
    }
    const interest = pay * n - p;
    const upfront = num(f, 'down');
    out.innerHTML = `<div class="result-card">
      <span class="eyebrow">${mode === 'budget' ? 'You can shop up to' : 'Monthly payment'}</span>
      <b class="big-num">${mode === 'budget' ? usd(price) : usd(pay)}</b>
      <span class="muted">${mode === 'budget' ? `vehicle price at ${usd(pay)}/month for ${n} months` : `for ${n} months at ${apr}% APR`}</span>
      <dl class="facts compact">
        <dt>Amount financed</dt><dd>${usd(p)}</dd>
        <dt>Total interest</dt><dd>${usd(interest)}</dd>
        <dt>Total of payments</dt><dd>${usd(pay * n)}</dd>
        <dt>Total cost incl. down payment</dt><dd>${usd(pay * n + upfront)}</dd>
      </dl>
      <div class="split" aria-label="Principal vs interest"><span style="flex:${p}"></span><span style="flex:${Math.max(interest, 0)}"></span></div>
      <div class="legend small"><span><i class="dot a"></i>Principal ${usd(p)}</span><span><i class="dot b"></i>Interest ${usd(interest)}</span></div>
    </div>`;

    const rows = [36, 48, 60, 72, 84].map((t) => {
      const q = mode === 'budget' ? principalFor(pay, apr, t) : p;
      const m = mode === 'budget' ? pay : payment(q, apr, t);
      return `<tr${t === n ? ' class="hl"' : ''}><td>${t} months</td><td class="num">${usd(m)}</td><td class="num">${usd(m * t - q)}</td><td class="num">${mode === 'budget' ? usd(priceFor(q, f)) : usd(m * t)}</td></tr>`;
    });
    document.getElementById('terms')!.innerHTML = `<thead><tr><th>Term</th><th class="num">Monthly</th><th class="num">Interest</th><th class="num">${mode === 'budget' ? 'Max price' : 'Total paid'}</th></tr></thead><tbody>${rows.join('')}</tbody>`;

    const yrs: string[] = [];
    let bal = p, paidI = 0;
    for (let i = 1; i <= n; i++) {
      const int = (bal * apr) / 1200;
      paidI += int;
      bal = Math.max(0, bal - (pay - int));
      if (i % 12 === 0 || i === n) yrs.push(`<tr><td>Year ${Math.ceil(i / 12)}</td><td class="num">${usd(paidI)}</td><td class="num">${usd(bal)}</td></tr>`);
    }
    document.getElementById('amort')!.innerHTML = `<thead><tr><th>End of</th><th class="num">Interest paid so far</th><th class="num">Balance left</th></tr></thead><tbody>${yrs.join('')}</tbody>`;
  }
  form.addEventListener('input', render);
  render();
</script>
