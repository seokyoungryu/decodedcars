---
import Base from '@/layouts/Base.astro';
import Ad from '@/components/Ad.astro';
import Stars from '@/components/Stars.astro';
import Bars from '@/components/Bars.astro';
import CarPhoto from '@/components/CarPhoto.astro';
import { VIN_LOOKUP } from '@/config/site';
import { type Model, comp, href, makes, model as loadModel, n } from '@/lib/data';

export function getStaticPaths() {
  return makes().flatMap((mk) => mk.models.map((mm) => ({ params: { make: mk.slug, model: mm.slug }, props: { m: loadModel(mk.slug, mm.slug)! } })));
}
const { m } = Astro.props as { m: Model };
const years = m.years.filter((y) => y.page);
const latest = years[0];
const first = years.at(-1)!;
const recallIds = new Set(years.flatMap((y) => y.recalls));
const totalComplaints = years.reduce((s, y) => s + y.complaints.total, 0);
const worst = [...years].sort((a, b) => b.complaints.total - a.complaints.total)[0];
// "best used year": 3+ years old, fewest problems (recalls weighted). Complaints are counted from 2015,
// so older model years would look artificially clean — only compare 2015+.
const fewest = [...years].filter((y) => y.year >= 2015 && y.year <= new Date().getUTCFullYear() - 3).sort((a, b) => a.complaints.total + a.recalls.length * 20 - (b.complaints.total + b.recalls.length * 20))[0];
const comps: Record<string, number> = {};
for (const y of years) for (const [c, k] of y.complaints.comps) comps[c] = (comps[c] ?? 0) + k;
const topComps = Object.entries(comps).sort((a, b) => b[1] - a[1]).slice(0, 8);
const classes = [...new Set(years.map((y) => y.cls).filter(Boolean))];
const mpgs = years.map((y) => y.mpg?.max).filter(Boolean) as number[];
const ranges = years.map((y) => y.range).filter(Boolean) as number[];
const len = (y: (typeof years)[number]) => y.dims.find((d) => d.length)?.length;
const wt = (y: (typeof years)[number]) => y.dims.find((d) => d.weight)?.weight;
const pop = m.popularity;
const title = `${m.make} ${m.model}`;
const desc = `${title} by model year (${first.year}–${latest.year}): specs, size, MPG${ranges.length ? ', EV range' : ''}, NHTSA safety ratings, ${recallIds.size} recalls and ${n(totalComplaints)} owner complaints compared${fewest ? `. Fewest problems: ${fewest.year}` : ''}.`;
---

<Base title={`${title}: Specs, MPG, Safety & Problems by Year`} description={desc} section="makes">
  <div class="crumbs"><a href="/makes">Makes</a>›<a href={`/${m.makeSlug}`}>{m.make}</a>›<span>{m.model}</span></div>
  <h1>{title}</h1>
  <p class="lead">{years.length} model years from {first.year} to {latest.year}, compared on size, efficiency, safety and reliability.</p>

  <div class="hero">
    <CarPhoto photo={m.photo} alt={title} eager />
    <dl class="facts">
      <dt>Model years</dt><dd>{first.year}–{latest.year}</dd>
      <dt>Class</dt><dd>{classes.slice(0, 3).join(', ') || '–'}</dd>
      <dt>Latest engines</dt><dd>{latest.engines.slice(0, 4).join(', ') || (latest.fuels.includes('EV') ? 'Electric' : '–')}</dd>
      {mpgs.length > 0 && (<><dt>Best MPG</dt><dd>{Math.min(...mpgs)}–{Math.max(...mpgs)} combined, by year</dd></>)}
      {ranges.length > 0 && (<><dt>EV range</dt><dd>up to {Math.max(...ranges)} mi</dd></>)}
      <dt>Latest rating</dt><dd><Stars value={years.find((y) => y.overall)?.overall} /> {years.find((y) => y.overall) ? `(${years.find((y) => y.overall)!.year})` : ''}</dd>
      <dt>Recalls</dt><dd>{recallIds.size} campaigns, all years</dd>
      {worst?.complaints.total ? (<><dt>Most complaints</dt><dd class="bad">{worst.year} ({n(worst.complaints.total)})</dd></>) : null}
      {fewest && fewest !== worst ? (<><dt>Fewest problems</dt><dd class="good">{fewest.year}</dd></>) : null}
      {pop?.views30 ? (<><dt>Interest</dt><dd>{n(pop.views30)} Wikipedia views / 30 days</dd></>) : null}
    </dl>
  </div>

  {
    m.overview && (
      <section class="section overview">
        <h2 style="margin-bottom:10px">About the {title}</h2>
        <p>{m.overview.text}</p>
        <p class="small muted">From the Wikipedia article "<a href={m.overview.url} rel="noopener" target="_blank">{m.overview.title}</a>", licensed under <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener license" target="_blank">CC BY-SA 4.0</a>.</p>
      </section>
    )
  }

  <section class="section">
    <div class="section-head"><h2>Every model year compared</h2></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Year</th><th>Engines</th><th class="num">Best MPG / range</th><th class="num">Length</th><th class="num">Weight</th><th>Overall</th><th class="num">Recalls</th><th class="num">Complaints</th></tr></thead>
        <tbody>
          {
            years.map((y) => (
              <tr>
                <td><a href={href(m, y.year)}>{y.year}</a></td>
                <td class="small">{y.engines.slice(0, 3).join(', ') || (y.fuels.includes('EV') ? 'Electric' : '–')}</td>
                <td class="num">{y.mpg ? `${y.mpg.max} MPG` : y.range ? `${y.range} mi` : '–'}</td>
                <td class="num">{len(y) ? `${len(y)} in` : '–'}</td>
                <td class="num">{wt(y) ? `${n(Math.round(wt(y)!))} lb` : '–'}</td>
                <td><Stars value={y.overall} /></td>
                <td class="num">{y.recalls.length}</td>
                <td class="num">{n(y.complaints.total)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  {mpgs.length > 1 && <Bars data={[...years].reverse().filter((y) => y.mpg).map((y) => [String(y.year), y.mpg!.max])} caption={`Best combined MPG by model year — ${title}`} fmt={(v) => `${v} MPG`} />}

  <Ad place="content" />

  {
    (latest.similar?.length ?? 0) > 0 && (
      <section class="section">
        <div class="section-head"><h2>Alternatives to the {latest.year} {m.model}</h2></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Model</th><th class="num">Best MPG / range</th><th>NHTSA overall</th><th class="num">Recalls</th></tr></thead>
            <tbody>
              {latest.similar!.map((s) => (
                <tr>
                  <td><a href={href(s, s.year)}>{s.year} {s.make} {s.model}</a></td>
                  <td class="num">{s.mpg ? `${s.mpg} MPG` : s.range ? `${s.range} mi` : '–'}</td>
                  <td><Stars value={s.overall} /></td>
                  <td class="num">{s.recalls}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    topComps.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>Most common owner-reported problems</h2></div>
        <div class="card bars">
          {topComps.map(([name, count]) => (
            <div class="bar"><span>{comp(name)}</span><span class="muted">{n(count)}</span><i style={`width:${Math.max(2, (count / topComps[0][1]) * 100)}%`} /></div>
          ))}
        </div>
        <Bars data={[...years].reverse().map((y) => [String(y.year), y.complaints.total])} caption={`Owner complaints by model year — ${title}`} />
      </section>
    )
  }

  <a class="cta" href={VIN_LOOKUP} target="_blank" rel="noopener">Check your VIN for open recalls ↗</a>
  <Ad place="bottom" />
  <p class="source">Sources: EPA fuel economy data; NHTSA ratings, recalls and complaints; Transport Canada Canadian Vehicle Specifications (Open Government Licence – Canada); Wikipedia (CC BY-SA 4.0) and Wikimedia Commons. Comparisons calculated by CarRadar. Not affiliated with NHTSA, the EPA or {m.make}.</p>
</Base>
