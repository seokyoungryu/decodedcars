---
import Base from '@/layouts/Base.astro';
import Ad from '@/components/Ad.astro';
import Stars from '@/components/Stars.astro';
import Bars from '@/components/Bars.astro';
import CarPhoto from '@/components/CarPhoto.astro';
import UsedChecklist from '@/components/UsedChecklist.astro';
import { VIN_LOOKUP, campaignUrl } from '@/config/site';
import { type Model, type Year, campaigns, comp, date, href, makes, model as loadModel, n, noindex, usd } from '@/lib/data';
import { bodyName, classNoun, describeYear } from '@/lib/describe';
import { changesBetween, previousYear } from '@/lib/changes';

export function getStaticPaths() {
  return makes().flatMap((mk) =>
    mk.models.flatMap((mm) => {
      const m = loadModel(mk.slug, mm.slug)!;
      return m.years.filter((y) => y.page).map((y) => ({ params: { make: mk.slug, model: mm.slug, year: String(y.year) }, props: { m, y } }));
    }),
  );
}

const { m, y } = Astro.props as { m: Model; y: Year };
const C = campaigns();
const recalls = y.recalls.map((id) => C[id]).filter(Boolean);
const name = `${y.year} ${m.make} ${m.model}`;
const others = m.years.filter((x) => x.page && x.year !== y.year);
const c = y.complaints;
const months = Object.entries(c.months ?? {}).sort((a, b) => a[0].localeCompare(b[0])).slice(-24);
const flags = recalls.filter((r) => r.doNotDrive || r.parkOutside);
const d0 = y.dims.find((d) => d.length) ?? y.dims[0];
const range = (vals: (number | undefined)[], unit: string, digits = 0) => {
  const v = vals.filter((x): x is number => !!x);
  if (!v.length) return '–';
  const lo = Math.min(...v), hi = Math.max(...v);
  const f = (x: number) => x.toLocaleString('en-US', { maximumFractionDigits: digits });
  return lo === hi ? `${f(lo)} ${unit}` : `${f(lo)}–${f(hi)} ${unit}`;
};
const bodies = y.dims.map((d) => bodyName(d.name, m.model)).filter(Boolean);
const summary = describeYear(m, y);
const prevY = previousYear(m, y);
const changes = prevY ? changesBetween(prevY, y) : [];
const ratingTop = y.rating?.find((r) => r.overall === y.overall) ?? y.rating?.[0];
const crashPics = (y.rating ?? []).flatMap((r) => [r.frontPic && { src: r.frontPic, cap: `Frontal crash test — ${r.desc}` }, r.sidePic && { src: r.sidePic, cap: `Side crash test — ${r.desc}` }]).filter(Boolean).slice(0, 2) as { src: string; cap: string }[];
const desc = `${name} specs, dimensions and MPG${y.range ? `, ${y.range}-mile range` : ''}${y.overall ? `, ${y.overall}-star NHTSA rating` : ''}, plus ${recalls.length} recall${recalls.length === 1 ? '' : 's'} and ${n(c.total)} owner complaints. Compare with other years and similar cars.`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Car',
    name,
    brand: { '@type': 'Brand', name: m.make },
    model: m.model,
    vehicleModelDate: String(y.year),
    ...(y.cls && { bodyType: y.cls }),
    ...(y.mpg && { fuelEfficiency: { '@type': 'QuantitativeValue', value: y.mpg.max, unitText: 'MPG' } }),
    ...(d0?.length && { depth: { '@type': 'QuantitativeValue', value: d0.length, unitCode: 'INH' } }),
    ...(d0?.weight && { weight: { '@type': 'QuantitativeValue', value: d0.weight, unitCode: 'LBR' } }),
  },
];
---

<Base title={`${name} Specs, MPG, Safety Rating & Recalls`} description={desc} section="makes" noindex={noindex().has(`/${m.makeSlug}/${m.slug}/${y.year}`)} jsonLd={jsonLd}>
  <div class="crumbs"><a href="/makes">Makes</a>›<a href={`/${m.makeSlug}`}>{m.make}</a>›<a href={href(m)}>{m.model}</a>›<span>{y.year}</span></div>
  <h1>{name}</h1>
  <p class="lead">Specs, dimensions, fuel economy, safety ratings and known problems.</p>

  <div class="hero">
    <CarPhoto photo={m.photo} alt={`${m.make} ${m.model}`} eager />
    <dl class="facts">
      <dt>Class</dt><dd>{y.cls ?? '–'}</dd>
      {bodies.length > 0 && (<><dt>Body styles</dt><dd>{bodies.slice(0, 4).join(', ')}</dd></>)}
      <dt>Engines</dt><dd>{y.engines.length ? y.engines.slice(0, 4).join(', ') : y.fuels.includes('EV') ? 'Electric motor' : '–'}</dd>
      <dt>Drivetrain</dt><dd>{y.drives.join(', ') || '–'}</dd>
      <dt>Fuel</dt><dd>{y.fuels.join(', ') || '–'}</dd>
      {y.mpg && (<><dt>MPG (best)</dt><dd><b>{y.mpg.max}</b> combined · {y.mpg.city} city / {y.mpg.hwy} hwy</dd></>)}
      {y.range && (<><dt>EV range</dt><dd><b>{y.range} mi</b>{y.charge ? ` · ${y.charge} h on 240 V` : ''}</dd></>)}
      <dt>Length</dt><dd>{range(y.dims.map((d) => d.length), 'in', 1)}</dd>
      <dt>Curb weight</dt><dd>{range(y.dims.map((d) => d.weight), 'lb')}</dd>
      <dt>NHTSA rating</dt><dd><Stars value={y.overall} /></dd>
      <dt>Recalls</dt><dd><a href="#recalls" class={recalls.length ? 'bad' : 'good'}>{recalls.length} campaign{recalls.length === 1 ? '' : 's'}</a></dd>
    </dl>
  </div>

  <nav class="tabs" aria-label="On this page">
    <a href="#overview">Overview</a>{prevY && <a href="#changes">What changed</a>}{y.dims.length > 0 && <a href="#dimensions">Dimensions</a>}<a href="#engines">Engines &amp; MPG</a><a href="#safety">Safety</a>{(y.similar?.length ?? 0) > 0 && <a href="#similar">Similar cars</a>}<a href="#recalls">Recalls</a><a href="#problems">Problems</a>{y.year <= new Date().getUTCFullYear() - 1 && <a href="#checklist">Used buyer checklist</a>}
  </nav>

  <section class="section overview" id="overview">
    <h2 style="margin-bottom:10px">Overview</h2>
    {summary.map((p) => <p>{p}</p>)}
  </section>

  {
    prevY && (
      <section class="section" id="changes">
        <div class="section-head"><h2>What changed for {y.year}</h2></div>
        {changes.length ? (
          <ul class="changes">{changes.map((c) => <li class={c.redesign ? 'big' : ''}>{c.text}</li>)}</ul>
        ) : (
          <p class="muted">No changes to engines, powertrains, drivetrains, size, EPA ratings or NHTSA crash rating compared with the {prevY.year} {m.model} — a carry-over year in the data.</p>
        )}
        <p class="small muted">Compared with the {prevY.year} model year, using EPA, Transport Canada and NHTSA data. Trim, feature and price changes are not covered.{prevY.page && <> <a href={href(m, prevY.year)}>See the {prevY.year} {m.model} →</a></>}</p>
      </section>
    )
  }

  {
    y.dims.length > 0 && (
      <section class="section" id="dimensions">
        <div class="section-head"><h2>Dimensions &amp; weight</h2></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Body</th><th class="num">Length</th><th class="num">Width</th><th class="num">Height</th><th class="num">Wheelbase</th><th class="num">Track F / R</th><th class="num">Curb weight</th><th class="num">Weight F/R</th></tr></thead>
            <tbody>
              {y.dims.map((d) => (
                <tr>
                  <td>{bodyName(d.name, m.model)}</td>
                  <td class="num">{d.length ? `${d.length} in` : '–'}</td>
                  <td class="num">{d.width ? `${d.width} in` : '–'}</td>
                  <td class="num">{d.height ? `${d.height} in` : '–'}</td>
                  <td class="num">{d.wheelbase ? `${d.wheelbase} in` : '–'}</td>
                  <td class="num">{d.trackF ? `${d.trackF} / ${d.trackR ?? '–'} in` : '–'}</td>
                  <td class="num">{d.weight ? `${n(Math.round(d.weight))} lb` : '–'}</td>
                  <td class="num">{d.weightDist ?? '–'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="small muted">Source: Canadian Vehicle Specifications, Transport Canada. Contains information licensed under the Open Government Licence – Canada. Canadian-market measurements; U.S. versions are usually the same or very close.</p>
        <a class="cta ghost" href={`/tools/garage-fit?a=${encodeURIComponent(`${m.make} ${m.model}`)}`}>Will it fit your garage? Check with your measurements →</a>
      </section>
    )
  }

  <section class="section" id="engines">
    <div class="section-head"><h2>Engines, MPG &amp; running costs</h2></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Version</th><th>Engine</th><th>Transmission</th><th>Drive</th><th class="num">City / Hwy / Comb</th><th class="num">vs. class</th><th class="num">Fuel / yr</th><th class="num">CO₂ g/mi</th></tr></thead>
        <tbody>
          {
            y.variants.map((v) => (
              <tr>
                <td>{v.name}{v.type && <> <span class="badge">{v.type}</span></>}</td>
                <td>{v.type === 'EV' ? v.motor ?? 'Electric' : `${v.displ ? `${v.displ.toFixed(1)}L ` : ''}${v.cyl ? `${v.cyl}-cyl` : ''}${v.turbo ? ' turbo' : ''}`}</td>
                <td>{v.trans ?? '–'}</td>
                <td>{v.drive ?? '–'}</td>
                <td class="num">{v.type === 'EV' ? `${v.range ?? '–'} mi${v.kwh ? ` · ${v.kwh} kWh/100mi` : ''}` : `${v.city ?? '–'} / ${v.hwy ?? '–'} / ${v.comb ?? '–'}`}</td>
                <td class={`num ${v.vsClass && v.vsClass > 0 ? 'good' : v.vsClass && v.vsClass < 0 ? 'bad' : ''}`}>{v.vsClass === undefined ? '–' : `${v.vsClass > 0 ? '+' : ''}${v.vsClass}%`}</td>
                <td class="num">{usd(v.cost)}</td>
                <td class="num">{v.co2 ? Math.round(v.co2) : '–'}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="stats">
      {y.feScore && <div class="stat"><b>{y.feScore}/10</b><span>EPA fuel economy score (best version)</span></div>}
      {y.ghgScore && <div class="stat"><b>{y.ghgScore}/10</b><span>EPA greenhouse gas score</span></div>}
      {y.save5 !== undefined && <div class="stat"><b class={y.save5 > 0 ? 'good' : 'bad'}>{y.save5 > 0 ? `Save ${usd(y.save5)}` : `Spend ${usd(-y.save5)}`}</b><span>Fuel over 5 years vs. average new car</span></div>}
      {y.classAvg && <div class="stat"><b>{y.classAvg} MPG</b><span>{y.year} {y.cls} average</span></div>}
    </div>
    <p class="small muted">EPA estimates; your mileage will vary. "vs. class" compares combined MPG with the {y.year} average for the same EPA size class. Fuel cost assumes 15,000 miles a year at current national prices.</p>
  </section>

  <Ad place="content" />

  <section class="section" id="safety">
    <div class="section-head"><h2>Safety ratings &amp; technology</h2></div>
    {
      y.rating?.length ? (
        <>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Version</th><th>Overall</th><th>Frontal</th><th>Driver / passenger</th><th>Side</th><th>Side pole</th><th>Rollover</th><th class="num">Rollover risk</th></tr></thead>
              <tbody>
                {y.rating.map((r) => (
                  <tr>
                    <td>{r.desc}</td>
                    <td><Stars value={r.overall} /></td>
                    <td><Stars value={r.front} /></td>
                    <td>{r.frontDriver ?? '–'}★ / {r.frontPassenger ?? '–'}★</td>
                    <td><Stars value={r.side} /></td>
                    <td><Stars value={r.sidePole} /></td>
                    <td><Stars value={r.rollover} /></td>
                    <td class="num">{r.rolloverRisk ? `${r.rolloverRisk}%` : '–'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {ratingTop && (ratingTop.esc || ratingTop.fcw || ratingTop.ldw) && (
            <div class="stats">
              {ratingTop.esc && <div class="stat"><b>{ratingTop.esc}</b><span>Electronic stability control</span></div>}
              {ratingTop.fcw && <div class="stat"><b>{ratingTop.fcw}</b><span>Forward collision warning</span></div>}
              {ratingTop.ldw && <div class="stat"><b>{ratingTop.ldw}</b><span>Lane departure warning</span></div>}
            </div>
          )}
          {crashPics.length > 0 && (
            <div class="crash">
              {crashPics.map((p) => (
                <figure><img src={p.src} alt={p.cap} loading="lazy" decoding="async" /><figcaption>{p.cap}. Photo: NHTSA.</figcaption></figure>
              ))}
            </div>
          )}
        </>
      ) : (
        <p class="muted">NHTSA has not published 5-Star ratings for the {name}{y.year < 2011 ? ' under the current (2011+) test program' : ''}.</p>
      )
    }
  </section>

  {
    (y.similar?.length ?? 0) > 0 && (
      <section class="section" id="similar">
        <div class="section-head"><h2>Similar {y.year} {classNoun(y.cls)}s</h2></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Model</th><th class="num">Best MPG / range</th><th>NHTSA overall</th><th class="num">Recalls</th></tr></thead>
            <tbody>
              <tr style="background:var(--brand-soft)"><td><b>{name}</b> (this car)</td><td class="num">{y.mpg ? `${y.mpg.max} MPG` : y.range ? `${y.range} mi` : '–'}</td><td><Stars value={y.overall} /></td><td class="num">{recalls.length}</td></tr>
              {y.similar!.map((s) => (
                <tr>
                  <td><a href={href(s, s.year)}>{s.year} {s.make} {s.model}</a></td>
                  <td class="num">{s.mpg ? `${s.mpg} MPG` : s.range ? `${s.range} mi` : '–'}</td>
                  <td><Stars value={s.overall} /></td>
                  <td class="num">{s.recalls}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  <section class="section" id="recalls">
    <div class="section-head"><h2>Recalls ({recalls.length})</h2></div>
    {
      flags.length > 0 && (
        <div class="note" style="background:var(--bad-bg);margin:0 0 12px">
          <b>Safety advisory:</b> {flags.length} recall{flags.length > 1 ? 's' : ''} for this model year carr{flags.length > 1 ? 'y' : 'ies'} a "Do Not Drive" or "Park Outside" warning. Check your VIN now.
        </div>
      )
    }
    {
      recalls.length ? (
        recalls.map((r) => (
          <details class="recall-item">
            <summary>
              {comp(r.comps[0])} <span class="small muted">· {date(r.date)}</span> {r.doNotDrive && <span class="badge bad">Do not drive</span>} {r.parkOutside && <span class="badge warn">Park outside</span>}
            </summary>
            <p class="small muted" style="margin:6px 0 0">NHTSA campaign <a href={campaignUrl(r.id)} target="_blank" rel="noopener">{r.id}</a>{r.units ? ` · ${n(r.units)} vehicles` : ''}</p>
            <dl>
              {r.summary && (<><dt>Problem</dt><dd>{r.summary}</dd></>)}
              {r.consequence && (<><dt>Risk</dt><dd>{r.consequence}</dd></>)}
              {r.remedy && (<><dt>Fix</dt><dd>{r.remedy}</dd></>)}
            </dl>
          </details>
        ))
      ) : (
        <p class="muted">No vehicle recalls on file with NHTSA for the {name}.</p>
      )
    }
    <a class="cta" href={VIN_LOOKUP} target="_blank" rel="noopener">Check your VIN for open recalls at NHTSA ↗</a>
    <p class="small muted" style="margin:6px 0 0">Recalls cover specific build dates and parts, so not every {name} is affected. Only a VIN check confirms your car's status.</p>
  </section>

  <section class="section" id="problems">
    <div class="section-head"><h2>Owner-reported problems</h2></div>
    {
      c.total ? (
        <>
          <div class="stats" style="margin-top:0">
            <div class="stat"><b>{n(c.total)}</b><span>Complaints to NHTSA since 2015</span></div>
            <div class="stat"><b>{n(c.crash)}</b><span>Involved a crash</span></div>
            <div class="stat"><b>{n(c.fire)}</b><span>Involved a fire</span></div>
            <div class="stat"><b>{n(c.injured)}</b><span>Injuries reported</span></div>
            {c.miles && <div class="stat"><b>{n(c.miles)} mi</b><span>Typical mileage at failure</span></div>}
          </div>
          <div class="card bars" style="margin-top:14px">
            {c.comps.map(([cname, count]) => (
              <div class="bar"><span>{comp(cname)}</span><span class="muted">{n(count)}</span><i style={`width:${Math.max(2, (count / c.comps[0][1]) * 100)}%`} /></div>
            ))}
          </div>
          <Bars data={months.map(([k, v]) => [k.slice(2).replace('-', '/'), v])} caption="Complaints received per month (last 24 months with reports)" />
          <p class="small muted">Unverified owner reports, counted once per report. Popular models collect more reports simply because more are on the road.</p>
        </>
      ) : (
        <p class="muted">No owner complaints for the {name} in NHTSA's database since 2015.</p>
      )
    }
  </section>

  {y.year <= new Date().getUTCFullYear() - 1 && <UsedChecklist m={m} y={y} recalls={recalls} />}

  {
    others.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>Other {m.model} years</h2><a href={href(m)}>Compare all years →</a></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Year</th><th class="num">Best MPG</th><th class="num">Length</th><th>Overall</th><th class="num">Recalls</th><th class="num">Complaints</th></tr></thead>
            <tbody>
              {others.slice(0, 12).map((o) => (
                <tr>
                  <td><a href={href(m, o.year)}>{o.year} {m.model}</a></td>
                  <td class="num">{o.mpg?.max ?? (o.range ? `${o.range} mi` : '–')}</td>
                  <td class="num">{o.dims.find((d) => d.length)?.length ? `${o.dims.find((d) => d.length)!.length} in` : '–'}</td>
                  <td><Stars value={o.overall} /></td>
                  <td class="num">{o.recalls.length}</td>
                  <td class="num">{n(o.complaints.total)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  <Ad place="bottom" />
  <p class="source">Sources: EPA fuel economy data; NHTSA NCAP ratings, recalls and consumer complaints; Transport Canada Canadian Vehicle Specifications (Open Government Licence – Canada); photo via Wikimedia Commons. Overview, comparisons and class averages are written and calculated by CarRadar. Not affiliated with NHTSA, the EPA, Transport Canada or {m.make}.</p>
</Base>
