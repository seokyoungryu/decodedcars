---
import ModelView from '@/views/ModelView.astro';
import { type Model, makes, model as loadModel } from '@/lib/data';

export function getStaticPaths() {
  return makes().flatMap((mk) => mk.models.map((mm) => ({ params: { make: mk.slug, model: mm.slug }, props: { m: loadModel(mk.slug, mm.slug)! } })));
}
const { m } = Astro.props as { m: Model };
---

<ModelView m={m} lang="es" />
