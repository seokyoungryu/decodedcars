---
import Base from '@/layouts/Base.astro';
import Ad from '@/components/Ad.astro';
import { GUIDES } from '@/lib/guides';

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: (typeof GUIDES)[number] };
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'Article', headline: g.title, description: g.description, dateModified: g.updated, inLanguage: 'en' }];
---

<Base title={g.title} description={g.description} section="guide" jsonLd={jsonLd}>
  <div class="crumbs"><a href="/guide">Guides</a></div>
  <article class="prose">
    <h1>{g.title}</h1>
    <p class="small muted">Updated {g.updated}</p>
    <g.Content />
  </article>
  <Ad place="bottom" />
  <ul class="list section prose">{GUIDES.filter((x) => x.slug !== g.slug).map((o) => <li><a href={`/guide/${o.slug}`}>{o.title}</a></li>)}</ul>
</Base>
