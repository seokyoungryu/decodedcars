---
// Home page (English /, Spanish /es). Rankings are English-only, so the Spanish home leaves those lists out.
import Base from '@/layouts/Base.astro';
import Ad from '@/components/Ad.astro';
import ModelCard from '@/components/ModelCard.astro';
import { VIN_LOOKUP } from '@/config/site';
import { href, makes, rankings, updatedLabel } from '@/lib/data';
import { RANKINGS } from '@/lib/rankings';
import { toolsFor } from '@/lib/tools';
import { type Lang, day, num, to } from '@/i18n';
import { compL } from '@/i18n/terms';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const es = lang === 'es';
const n = (x?: number) => num(lang, x);
const TOOLS = toolsFor(lang);

const R = rankings();
const popularMakes = makes()
  .map((m) => ({ ...m, v: m.models.reduce((s, x) => s + x.views30, 0) }))
  .sort((a, b) => b.v - a.v)
  .slice(0, 24);
const sub = (x: { latest?: number; [k: string]: unknown }) => `${x.latest ?? ''}${x.views30 ? ` · ${n(x.views30 as number)} ${es ? 'visitas/mes' : 'views/mo'}` : ''}`;
const modelCount = makes().reduce((s, m) => s + m.models.length, 0);
const yearCount = makes().reduce((s, m) => s + m.models.reduce((t, x) => t + (x.to - x.from + 1), 0), 0);
const T = es
  ? { title: 'Ficha técnica, consumo, seguridad y retiros de autos', eyebrow: 'Investigación independiente de autos · actualizada a diario', h1: 'Conoce el auto antes de comprarlo', lead: 'Ficha técnica, tamaño, consumo real, pruebas de choque, retiros y problemas reportados por propietarios de cada auto, camioneta y SUV de EE. UU. desde 2005, además de los mejores y peores años para comprar usado.', search: 'Busca cualquier modelo: p. ej. RAV4, F-150, Model 3', searchLabel: 'Buscar modelos', models: 'modelos', modelYears: 'años modelo', makes: 'marcas', updated: 'última actualización', hot: 'Los más buscados ahora', viewsMonth: 'visitas este mes', byMake: 'Explorar por marca', allMakes: 'Todas las marcas →', most: 'Autos más investigados', trending: 'Tendencia esta semana', interest: 'de interés esta semana', newH: 'Modelos y años nuevos', rangeMi: 'mi de autonomía', recallsH: 'Retiros recientes', allRecalls: 'Todos los retiros nuevos (en inglés) →', more: 'más', dnd: 'No conducir', vehicles: 'vehículos', vin: 'Consulta tu VIN en NHTSA (en inglés) ↗', none: 'Sin resultados: abre el buscador de autos →' }
  : { title: 'Car specs, MPG, safety ratings and recalls', eyebrow: 'Independent car research · updated daily', h1: 'Know the car before you buy it', lead: 'Specs, size, real-world MPG, crash ratings, recalls and owner-reported problems for every U.S. car, truck and SUV since 2005 — plus the best and worst years to buy used.', search: 'Search any model — e.g. RAV4, F-150, Model 3', searchLabel: 'Search models', models: 'models', modelYears: 'model years', makes: 'makes', updated: 'last update', hot: 'Most researched right now', viewsMonth: 'views this month', byMake: 'Browse by make', allMakes: 'All makes →', most: 'Most researched cars', trending: 'Trending this week', interest: 'interest this week', newH: 'New models & model years', rangeMi: 'mi range', recallsH: 'Latest recalls', allRecalls: 'All new recalls →', more: 'more', dnd: 'Do not drive', vehicles: 'vehicles', vin: 'Check your VIN for open recalls ↗', none: 'No match — open the car finder →' };
const BODY_ES = { Car: 'Auto', SUV: 'SUV', Pickup: 'Pickup', Minivan: 'Minivan', Van: 'Van', Wagon: 'Familiar', 'Sports / 2-seat': 'Deportivo / biplaza', Other: 'Otro' };
const lists = [
  { r: RANKINGS.find((x) => x.slug === 'best-mpg')!, rows: R.bestMpg.slice(0, 6) },
  { r: RANKINGS.find((x) => x.slug === 'longest-range')!, rows: R.longestRange.slice(0, 6) },
  { r: RANKINGS.find((x) => x.slug === 'most-complaints')!, rows: R.complaints90.slice(0, 6) },
];
---

<Base title={T.title} lang={lang} alt={es ? '/' : '/es'}>
  <section class="band">
   <div class="band-grid">
   <div>
    <span class="eyebrow">{T.eyebrow}</span>
    <h1 style="margin-top:10px">{T.h1}</h1>
    <p class="lead">{T.lead}</p>
    <div class="search" id="qs" data-pre={es ? '/es' : ''} data-none={T.none} data-body={JSON.stringify(es ? BODY_ES : {})}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <input type="search" placeholder={T.search} aria-label={T.searchLabel} autocomplete="off" />
      <div class="search-results" hidden></div>
    </div>
    <div class="hero-stats">
      <span><b>{n(modelCount)}</b>{T.models}</span>
      <span><b>{n(yearCount)}</b>{T.modelYears}</span>
      <span><b>{n(makes().length)}</b>{T.makes}</span>
      <span><b>{updatedLabel(lang)}</b>{T.updated}</span>
    </div>
   </div>
    <aside class="hot">
      <span class="eyebrow">{T.hot}</span>
      {R.popular.slice(0, 4).map((x, i) => (
        <a href={to(lang, href(x))}>
          <b class="rank">{i + 1}</b>
          {x.photo ? <img src={`/photos/${x.photo}`} alt="" width="96" height="60" loading="eager" /> : <i class="ph" />}
          <span><strong>{x.make} {x.model}</strong><small>{x.views30 ? `${n(x.views30 as number)} ${T.viewsMonth}` : x.latest}</small></span>
        </a>
      ))}
    </aside>
   </div>
    <div class="tool-cards" style="margin-top:34px">
      {TOOLS.map((t) => (
        <a href={t.href}><span class="ic" set:html={t.icon} /><h2>{t.title}</h2><p>{t.short}</p></a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>{T.byMake}</h2><a href={to(lang, '/makes')}>{T.allMakes}</a></div>
    <div class="chips">{popularMakes.map((m) => <a href={to(lang, `/${m.slug}`)}>{m.name}</a>)}</div>
  </section>

  <section class="section">
    <div class="section-head"><h2>{T.most}</h2>{!es && <a href="/rankings/popular">Top 30 →</a>}</div>
    <div class="mcards">{R.popular.slice(0, 12).map((x) => <ModelCard href={to(lang, href(x))} title={`${x.make} ${x.model}`} sub={sub(x)} photo={x.photo} />)}</div>
  </section>

  {
    R.trending.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>{T.trending}</h2>{!es && <a href="/rankings/trending">More →</a>}</div>
        <div class="mcards">{R.trending.slice(0, 6).map((x) => <ModelCard href={to(lang, href(x))} title={`${x.make} ${x.model}`} sub={`${(x.change as number) > 0 ? '+' : ''}${x.change}% ${T.interest}`} photo={x.photo} />)}</div>
      </section>
    )
  }

  <Ad place="content" lang={lang} />

  {!es && (<div class="grid section">
    {
      lists.map(({ r, rows }) => (
        <div class="card">
          <div class="section-head" style="margin-bottom:6px"><h2 style="font-size:1.05rem">{r.title}</h2><a href={`/rankings/${r.slug}`}>More →</a></div>
          <ol class="list" style="padding:0">
            {rows.map((x) => (
              <li>
                <a href={r.yearLink && x.year ? href(x, x.year) : href(x)}>{r.yearLink && x.year ? `${x.year} ` : ''}{x.make} {x.model}</a>
                <span class="small muted">{r.value(x)}</span>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>)}

  {
    R.newModels.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>{T.newH}</h2>{!es && <a href="/rankings/new-models">All →</a>}</div>
        <div class="mcards">{R.newModels.slice(0, 6).map((x) => <ModelCard href={es ? to(lang, href(x)) : href(x, x.year)} title={es ? `${x.make} ${x.model} ${x.year}` : `${x.year} ${x.make} ${x.model}`} sub={x.range ? `${x.range} ${T.rangeMi}` : x.mpg ? `${x.mpg} MPG` : undefined} photo={x.photo} />)}</div>
      </section>
    )
  }

  <section class="section">
    <div class="section-head"><h2>{T.recallsH}</h2><a href="/recalls">{T.allRecalls}</a></div>
    <div class="card">
      <ul class="list">
        {
          R.recentRecalls.slice(0, 6).map((r) => (
            <li>
              <span>
                {r.models.slice(0, 2).map((m, i) => <>{i > 0 && ', '}<a href={es ? to(lang, href(m)) : href(m, m.year)}>{es ? `${m.make} ${m.model} ${m.year}` : `${m.year} ${m.make} ${m.model}`}</a></>)}
                {r.models.length > 2 && <span class="muted"> +{r.models.length - 2} {T.more}</span>}
                <span class="small muted"> · {compL(lang, r.comp)}</span>
                {r.doNotDrive && <> <span class="badge bad">{T.dnd}</span></>}
              </span>
              <span class="small muted" style="white-space:nowrap">{day(lang, r.date)}{r.units ? ` · ${n(r.units)} ${T.vehicles}` : ''}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <a class="cta" href={VIN_LOOKUP} target="_blank" rel="noopener">{T.vin}</a>
  </section>

  {!es && (<section class="section">
    <div class="section-head"><h2>Rankings</h2></div>
    <div class="chips">{RANKINGS.map((r) => <a href={`/rankings/${r.slug}`}>{r.short}</a>)}</div>
  </section>)}
</Base>

<script>
  // Instant model search over the finder index (same data as the car finder; loaded on first focus)
  type Row = { mk: string; md: string; ms: string; s: string; y: number; body: string; pop: number; ph?: string };
  const box = document.getElementById('qs')!;
  const input = box.querySelector('input')!;
  const list = box.querySelector<HTMLElement>('.search-results')!;
  const PRE = box.dataset.pre ?? '';
  const BODY: Record<string, string> = JSON.parse(box.dataset.body || '{}');
  const esc = (s = '') => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');
  let rows: Row[] | null = null;
  let hits: Row[] = [];
  let on = 0;
  const load = () => (rows ? Promise.resolve() : fetch('/finder-data.json').then((r) => r.json()).then((d) => void (rows = d.rows)));

  function show() {
    const q = norm(input.value);
    if (!q || !rows) return void (list.hidden = true);
    hits = rows
      .map((r) => ({ r, k: norm(`${r.mk}${r.md}`), m: norm(r.md) }))
      .filter((x) => x.k.includes(q) || x.m.startsWith(q))
      .sort((a, b) => Number(b.m.startsWith(q)) - Number(a.m.startsWith(q)) || b.r.pop - a.r.pop)
      .slice(0, 8)
      .map((x) => x.r);
    on = 0;
    list.innerHTML = hits.length
      ? hits.map((r, i) => `<a href="${PRE}/${r.ms}/${r.s}"${i === 0 ? ' class="on"' : ''}>${r.ph ? `<img src="/photos/${encodeURIComponent(r.ph)}" alt="" loading="lazy">` : '<i class="ph"></i>'}${esc(r.mk)} ${esc(r.md)}<span>${r.y} · ${esc(BODY[r.body] ?? r.body)}</span></a>`).join('')
      : `<a href="${PRE}/finder">${esc(box.dataset.none)}</a>`;
    list.hidden = false;
  }
  input.addEventListener('focus', () => load().then(show));
  input.addEventListener('input', () => load().then(show));
  input.addEventListener('keydown', (e) => {
    const links = [...list.querySelectorAll('a')];
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      on = (on + (e.key === 'ArrowDown' ? 1 : links.length - 1)) % Math.max(links.length, 1);
      links.forEach((a, i) => a.classList.toggle('on', i === on));
    } else if (e.key === 'Enter' && links[on]) location.href = links[on].href;
    else if (e.key === 'Escape') list.hidden = true;
  });
  document.addEventListener('click', (e) => !box.contains(e.target as Node) && (list.hidden = true));
</script>
