---
// One model year (English at /make/model/year, Spanish at /es/make/model/year)
import Base from '@/layouts/Base.astro';
import Ad from '@/components/Ad.astro';
import Stars from '@/components/Stars.astro';
import Bars from '@/components/Bars.astro';
import CarPhoto from '@/components/CarPhoto.astro';
import UsedChecklist from '@/components/UsedChecklist.astro';
import { VIN_LOOKUP, campaignUrl } from '@/config/site';
import { type Model, type Year, campaigns, href, noindex } from '@/lib/data';
import { bodyName, describeYear, describeYearEs } from '@/lib/describe';
import { changesBetween, previousYear } from '@/lib/changes';
import { prosCons } from '@/lib/proscons';
import { type Lang, day, money, num, to } from '@/i18n';
import { classL, classNounL, compL, driveL, engineL, featureL, fuelL, transL, availL } from '@/i18n/terms';

interface Props {
  m: Model;
  y: Year;
  lang: Lang;
}
const { m, y, lang } = Astro.props;
const es = lang === 'es';
const C = campaigns();
const recalls = y.recalls.map((id) => C[id]).filter(Boolean);
const name = es ? `${m.make} ${m.model} ${y.year}` : `${y.year} ${m.make} ${m.model}`;
const yName = (year: number) => (es ? `${m.model} ${year}` : `${year} ${m.model}`);
/** link to a model year: Spanish only when that year has a Spanish page */
const yearLink = (c: { makeSlug: string; slug: string }, year: number, hasEs?: boolean) => (es && hasEs ? to('es', href(c, year)) : href(c, year));
const others = m.years.filter((x) => x.page && x.year !== y.year);
const c = y.complaints;
const months = Object.entries(c.months ?? {}).sort((a, b) => a[0].localeCompare(b[0])).slice(-24);
const flags = recalls.filter((r) => r.doNotDrive || r.parkOutside);
const d0 = y.dims.find((d) => d.length) ?? y.dims[0];
const range = (vals: (number | undefined)[], unit: string, digits = 0) => {
  const v = vals.filter((x): x is number => !!x);
  if (!v.length) return '–';
  const lo = Math.min(...v), hi = Math.max(...v);
  const f = (x: number) => x.toLocaleString(es ? 'es-US' : 'en-US', { maximumFractionDigits: digits });
  return lo === hi ? `${f(lo)} ${unit}` : `${f(lo)}–${f(hi)} ${unit}`;
};
const bodies = y.dims.map((d) => bodyName(d.name, m.model)).filter(Boolean);
const summary = es ? describeYearEs(m, y) : describeYear(m, y);
const prevY = previousYear(m, y);
const changes = prevY ? changesBetween(prevY, y, lang) : [];
const pc = prosCons(m, y, recalls, lang);
const sp = y.specs;
const hpText = (h?: [number, number]) => (h ? (h[0] === h[1] ? `${h[0]} hp` : `${h[0]}–${h[1]} hp`) : undefined);
const seatsText = (s: [number, number]) => (s[0] === s[1] ? String(s[0]) : `${s[0]}–${s[1]}`);
const ratingTop = y.rating?.find((r) => r.overall === y.overall) ?? y.rating?.[0];
const usedYear = y.year <= new Date().getUTCFullYear() - 1;

const T = {
  en: {
    title: `${name} Specs, MPG, Safety Rating & Recalls`,
    desc: `${name} specs, dimensions and MPG${y.range ? `, ${y.range}-mile range` : ''}${y.overall ? `, ${y.overall}-star NHTSA rating` : ''}, plus ${recalls.length} recall${recalls.length === 1 ? '' : 's'} and ${num(lang, c.total)} owner complaints. Compare with other years and similar cars.`,
    how: 'How we calculate this →', makes: 'Makes', lead: `Trims, performance, features, fuel economy, safety and known problems — with the pros and cons against similar ${y.year} models.`,
    cls: 'Class', bodies: 'Body styles', engines: 'Engines', electric: 'Electric motor', hp: 'Horsepower', trans: 'Transmission', drive: 'Drivetrain', seats: 'Seats', fuel: 'Fuel',
    mpgBest: 'MPG (best)', comb: 'combined', city: 'city', hwy: 'hwy', evRange: 'EV range', on240: 'h on 240 V', length: 'Length', weight: 'Curb weight', rating: 'NHTSA rating', recalls: 'Recalls',
    campaigns: (k: number) => `${k} campaign${k === 1 ? '' : 's'}`,
    pc: 'Pros & cons', good: "What's good", watch: 'Watch out for', noPros: 'Nothing stands out against similar models in the data.', noCons: 'No weak spots against similar models in the data.',
    pcNote: `Calculated from EPA, NHTSA and vPIC data${y.peer ? ` against ${y.peer.n} similar ${y.year} models` : ''} — not a review.`,
    onPage: 'On this page', overview: 'Overview', changed: 'What changed', trims: 'Trims & features', dims: 'Dimensions', engMpg: 'Engines & MPG', safety: 'Safety', similar: 'Similar cars', problems: 'Problems', checklist: 'Used buyer checklist',
    changedFor: `What changed for ${y.year}`,
    noChange: (p: number) => `No changes to engines, powertrains, drivetrains, size, EPA ratings or NHTSA crash rating compared with the ${yName(p)} — a carry-over year in the data.`,
    changeNote: (p: number) => `Compared with ${p}; trim, feature and price changes aren't covered.`, see: (p: number) => `See the ${yName(p)} →`,
    trimsH: 'Trims, performance & features', engine: 'Engine', powertrain: 'Powertrain', plusMotor: (h: number) => ` + ${h} hp electric motor`, drv: 'Drive', seating: 'Seating', seatsW: 'seats', rows: 'rows',
    trimsList: 'Trims', features: 'Safety & driver-assist features', featV: { std: 'Standard', some: 'Some trims', opt: 'Optional' }, led: 'LED headlights', yes: 'Yes', built: 'Built in:',
    specNote: (k: number) => `NHTSA vPIC, as reported by the manufacturer for ${k} ${y.year} ${m.model} configuration${k === 1 ? '' : 's'}; may not list every trim.`,
    dimsH: 'Dimensions & weight', body: 'Body', width: 'Width', height: 'Height', wb: 'Wheelbase', track: 'Track F / R', wdist: 'Weight F/R',
    dimsNote: 'Transport Canada CVS (Open Government Licence – Canada), Canadian-market figures.',
    garage: 'Will it fit your garage? Check with your measurements →',
    engH: 'Engines, MPG & running costs', version: 'Version', cityHwy: 'City / Hwy / Comb', vsClass: 'vs. class', fuelYr: 'Fuel / yr', co2: 'CO₂ g/mi',
    feScore: 'EPA fuel economy score (best version)', ghg: 'EPA greenhouse gas score', save: (v: string) => `Save ${v}`, spend: (v: string) => `Spend ${v}`, fuel5: 'Fuel over 5 years vs. average new car', avg: `${y.year} ${classL(lang, y.cls)} average`,
    engNote: `EPA estimates; "vs. class" is combined MPG against the ${y.year} EPA class average.`,
    safetyH: 'Safety ratings & technology', overall: 'Overall', frontal: 'Frontal', drvPass: 'Driver / passenger', side: 'Side', pole: 'Side pole', rollover: 'Rollover', risk: 'Rollover risk',
    esc: 'Electronic stability control', fcw: 'Forward collision warning', ldw: 'Lane departure warning', frontCrash: 'Frontal crash test', sideCrash: 'Side crash test', photoN: 'Photo: NHTSA.',
    noRating: `NHTSA has not published 5-Star ratings for the ${name}${y.year < 2011 ? ' under the current (2011+) test program' : ''}.`,
    similarH: `Similar ${y.year} ${classNounL(lang, y.cls)}s`, model: 'Model', bestMpg: 'Best MPG / range', nhtsaOverall: 'NHTSA overall', thisCar: '(this car)',
    recallsH: `Recalls (${recalls.length})`, advisory: 'Safety advisory:', advisoryText: (k: number) => `${k} recall${k > 1 ? 's' : ''} for this model year carr${k > 1 ? 'y' : 'ies'} a "Do Not Drive" or "Park Outside" warning. Check your VIN now.`,
    dnd: 'Do not drive', park: 'Park outside', campaign: 'NHTSA campaign', vehicles: 'vehicles', problem: 'Problem', riskL: 'Risk', fix: 'Fix', officialEn: '',
    noRecalls: `No vehicle recalls on file with NHTSA for the ${name}.`, vinBtn: 'Check your VIN for open recalls at NHTSA ↗',
    recallNote: `Not every ${name} is affected — only a VIN check confirms your car.`,
    problemsH: 'Owner-reported problems', cmplSince: 'Complaints to NHTSA since 2015', crash: 'Involved a crash', fire: 'Involved a fire', injured: 'Injuries reported', miles: 'Typical mileage at failure',
    perMonth: 'Complaints received per month (last 24 months with reports)', cmplNote: 'Unverified owner reports; best-sellers collect more.',
    noCmpl: `No owner complaints for the ${name} in NHTSA's database since 2015.`,
    otherH: `Other ${m.model} years`, compareAll: 'Compare all years →', yearH: 'Year', complaints: 'Complaints',
    source: `Sources: EPA, NHTSA, Transport Canada, Wikimedia Commons. Not affiliated with NHTSA, the EPA or ${m.make}.`,
  },
  es: {
    title: `${name}: ficha técnica, consumo, seguridad y retiros`,
    desc: `${name}: ficha técnica, dimensiones y consumo (MPG)${y.range ? `, ${y.range} millas de autonomía` : ''}${y.overall ? `, ${y.overall} estrellas NHTSA` : ''}, ${recalls.length} ${recalls.length === 1 ? 'retiro' : 'retiros'} y ${num(lang, c.total)} quejas de propietarios. Compara con otros años y autos similares.`,
    how: 'Cómo lo calculamos →', makes: 'Marcas', lead: `Versiones, desempeño, equipamiento, consumo, seguridad y problemas conocidos, con sus ventajas y desventajas frente a modelos similares ${y.year}.`,
    cls: 'Clase', bodies: 'Carrocerías', engines: 'Motores', electric: 'Motor eléctrico', hp: 'Potencia', trans: 'Transmisión', drive: 'Tracción', seats: 'Asientos', fuel: 'Combustible',
    mpgBest: 'MPG (mejor)', comb: 'combinadas', city: 'ciudad', hwy: 'carretera', evRange: 'Autonomía eléctrica', on240: 'h a 240 V', length: 'Largo', weight: 'Peso en vacío', rating: 'Calificación NHTSA', recalls: 'Retiros',
    campaigns: (k: number) => `${k} ${k === 1 ? 'campaña' : 'campañas'}`,
    pc: 'Ventajas y desventajas', good: 'Lo bueno', watch: 'A tener en cuenta', noPros: 'Nada destaca frente a modelos similares en los datos.', noCons: 'Sin puntos débiles frente a modelos similares en los datos.',
    pcNote: `Calculado con datos de la EPA, la NHTSA y vPIC${y.peer ? ` frente a ${y.peer.n} modelos similares ${y.year}` : ''}; no es una reseña.`,
    onPage: 'En esta página', overview: 'Resumen', changed: 'Novedades', trims: 'Versiones y equipo', dims: 'Dimensiones', engMpg: 'Motores y consumo', safety: 'Seguridad', similar: 'Autos similares', problems: 'Problemas', checklist: 'Lista para comprar usado',
    changedFor: `Novedades del ${y.year}`,
    noChange: (p: number) => `Sin cambios en motores, versiones, tracción, tamaño, consumo EPA ni calificación NHTSA respecto al ${yName(p)}: un año sin cambios según los datos.`,
    changeNote: (p: number) => `Comparado con ${p}; no incluye cambios de versiones, equipamiento ni precio.`, see: (p: number) => `Ver el ${yName(p)} →`,
    trimsH: 'Versiones, desempeño y equipamiento', engine: 'Motor', powertrain: 'Tren motriz', plusMotor: (h: number) => ` + motor eléctrico de ${h} hp`, drv: 'Tracción', seating: 'Asientos', seatsW: 'asientos', rows: 'filas',
    trimsList: 'Versiones', features: 'Seguridad y asistencias al conductor', featV: { std: 'De serie', some: 'Algunas versiones', opt: 'Opcional' }, led: 'Faros LED', yes: 'Sí', built: 'Fabricado en:',
    specNote: (k: number) => `NHTSA vPIC, según el fabricante, para ${k} ${k === 1 ? 'configuración' : 'configuraciones'} del ${m.model} ${y.year}; puede no incluir todas las versiones.`,
    dimsH: 'Dimensiones y peso', body: 'Carrocería', width: 'Ancho', height: 'Alto', wb: 'Distancia entre ejes', track: 'Vía del. / tras.', wdist: 'Peso del./tras.',
    dimsNote: 'Transport Canada CVS (Open Government Licence – Canada), medidas del mercado canadiense.',
    garage: '¿Cabe en tu garaje? Compruébalo con tus medidas →',
    engH: 'Motores, consumo y costo de uso', version: 'Versión', cityHwy: 'Ciudad / Carr. / Comb.', vsClass: 'vs. su clase', fuelYr: 'Combustible / año', co2: 'CO₂ g/mi',
    feScore: 'Puntaje EPA de consumo (mejor versión)', ghg: 'Puntaje EPA de gases de efecto invernadero', save: (v: string) => `Ahorra ${v}`, spend: (v: string) => `Gasta ${v}`, fuel5: 'Combustible en 5 años vs. un auto nuevo promedio', avg: `Promedio ${y.year}: ${classL(lang, y.cls)}`,
    engNote: `Estimaciones de la EPA; "vs. su clase" compara las MPG combinadas con el promedio ${y.year} de su clase EPA.`,
    safetyH: 'Calificaciones de seguridad y tecnología', overall: 'General', frontal: 'Frontal', drvPass: 'Conductor / pasajero', side: 'Lateral', pole: 'Poste lateral', rollover: 'Volcadura', risk: 'Riesgo de volcadura',
    esc: 'Control electrónico de estabilidad', fcw: 'Alerta de colisión frontal', ldw: 'Alerta de salida de carril', frontCrash: 'Prueba de choque frontal', sideCrash: 'Prueba de choque lateral', photoN: 'Foto: NHTSA.',
    noRating: `La NHTSA no ha publicado calificaciones de 5 estrellas para el ${name}${y.year < 2011 ? ' con el programa de pruebas actual (2011+)' : ''}.`,
    similarH: `${classNounL(lang, y.cls).replace(/^./, (x) => x.toUpperCase())} similares ${y.year}`, model: 'Modelo', bestMpg: 'Mejor MPG / autonomía', nhtsaOverall: 'General NHTSA', thisCar: '(este auto)',
    recallsH: `Retiros (${recalls.length})`, advisory: 'Aviso de seguridad:', advisoryText: (k: number) => `${k} ${k > 1 ? 'retiros' : 'retiro'} de este año modelo ${k > 1 ? 'tienen' : 'tiene'} aviso de "no conducir" o "estacionar afuera". Consulta tu VIN ahora.`,
    dnd: 'No conducir', park: 'Estacionar afuera', campaign: 'Campaña NHTSA', vehicles: 'vehículos', problem: 'Problema', riskL: 'Riesgo', fix: 'Solución', officialEn: 'Texto oficial de la NHTSA (en inglés).',
    noRecalls: `No hay retiros registrados en la NHTSA para el ${name}.`, vinBtn: 'Consulta tu VIN en NHTSA (en inglés) ↗',
    recallNote: `No todos los ${m.model} ${y.year} están afectados: solo el VIN lo confirma.`,
    problemsH: 'Problemas reportados por propietarios', cmplSince: 'Quejas ante la NHTSA desde 2015', crash: 'Con choque', fire: 'Con incendio', injured: 'Lesionados reportados', miles: 'Millaje típico de la falla',
    perMonth: 'Quejas recibidas por mes (últimos 24 meses con reportes)', cmplNote: 'Reportes sin verificar; los más vendidos acumulan más.',
    noCmpl: `No hay quejas de propietarios del ${name} en la base de datos de la NHTSA desde 2015.`,
    otherH: `Otros años del ${m.model}`, compareAll: 'Comparar todos los años →', yearH: 'Año', complaints: 'Quejas',
    source: `Fuentes: EPA, NHTSA, Transport Canada, Wikimedia Commons. Sin afiliación con la NHTSA, la EPA ni ${m.make}.`,
  },
}[lang];
const crashPics = (y.rating ?? []).flatMap((r) => [r.frontPic && { src: r.frontPic, cap: `${T.frontCrash} — ${r.desc}` }, r.sidePic && { src: r.sidePic, cap: `${T.sideCrash} — ${r.desc}` }]).filter(Boolean).slice(0, 2) as { src: string; cap: string }[];
const path = href(m, y.year);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Car',
    name,
    brand: { '@type': 'Brand', name: m.make },
    model: m.model,
    vehicleModelDate: String(y.year),
    ...(y.cls && { bodyType: classL(lang, y.cls) }),
    ...(y.mpg && { fuelEfficiency: { '@type': 'QuantitativeValue', value: y.mpg.max, unitText: 'MPG' } }),
    ...(d0?.length && { depth: { '@type': 'QuantitativeValue', value: d0.length, unitCode: 'INH' } }),
    ...(d0?.weight && { weight: { '@type': 'QuantitativeValue', value: d0.weight, unitCode: 'LBR' } }),
  },
];
---

<Base title={T.title} description={T.desc} section="makes" lang={lang} alt={y.es ? (es ? path : to('es', path)) : undefined} noindex={!es && noindex().has(path)} jsonLd={jsonLd}>
  <div class="crumbs"><a href={to(lang, '/makes')}>{T.makes}</a>›<a href={to(lang, `/${m.makeSlug}`)}>{m.make}</a>›<a href={to(lang, href(m))}>{m.model}</a>›<span>{y.year}</span></div>
  <h1>{name}</h1>
  <p class="lead">{T.lead}</p>

  <div class="hero">
    <CarPhoto photo={m.photo} alt={`${m.make} ${m.model}`} eager lang={lang} />
    <dl class="facts">
      <dt>{T.cls}</dt><dd>{classL(lang, y.cls)}</dd>
      {bodies.length > 0 && (<><dt>{T.bodies}</dt><dd>{bodies.slice(0, 4).join(', ')}</dd></>)}
      <dt>{T.engines}</dt><dd>{y.engines.length ? y.engines.slice(0, 4).map((e) => engineL(lang, e)).join(', ') : y.fuels.includes('EV') ? T.electric : '–'}</dd>
      {sp?.hp && (<><dt>{T.hp}</dt><dd><b>{hpText(sp.hp)}</b></dd></>)}
      {sp?.trans.length ? (<><dt>{T.trans}</dt><dd>{sp.trans.map((x) => transL(lang, x)).join(', ')}</dd></>) : null}
      <dt>{T.drive}</dt><dd>{y.drives.map((d) => driveL(lang, d)).join(', ') || '–'}</dd>
      {sp?.seats && (<><dt>{T.seats}</dt><dd>{seatsText(sp.seats)}</dd></>)}
      <dt>{T.fuel}</dt><dd>{y.fuels.map((f) => fuelL(lang, f)).join(', ') || '–'}</dd>
      {y.mpg && (<><dt>{T.mpgBest}</dt><dd><b>{y.mpg.max}</b> {T.comb} · {y.mpg.city} {T.city} / {y.mpg.hwy} {T.hwy}</dd></>)}
      {y.range && (<><dt>{T.evRange}</dt><dd><b>{y.range} mi</b>{y.charge ? ` · ${y.charge} ${T.on240}` : ''}</dd></>)}
      <dt>{T.length}</dt><dd>{range(y.dims.map((d) => d.length), 'in', 1)}</dd>
      <dt>{T.weight}</dt><dd>{range(y.dims.map((d) => d.weight), 'lb')}</dd>
      <dt>{T.rating}</dt><dd><Stars value={y.overall} lang={lang} /></dd>
      <dt>{T.recalls}</dt><dd><a href="#recalls" class={recalls.length ? 'bad' : 'good'}>{T.campaigns(recalls.length)}</a></dd>
    </dl>
  </div>

  {
    (pc.pros.length > 0 || pc.cons.length > 0) && (
      <section class="section" id="proscons">
        <div class="section-head"><h2>{T.pc}</h2></div>
        <div class="pc-grid">
          <div class="pc pros"><h3>{T.good}</h3>{pc.pros.length ? <ul>{pc.pros.map((p) => <li><b>{p.title}</b>{p.detail && <span>{p.detail}</span>}</li>)}</ul> : <p class="muted small">{T.noPros}</p>}</div>
          <div class="pc cons"><h3>{T.watch}</h3>{pc.cons.length ? <ul>{pc.cons.map((p) => <li><b>{p.title}</b>{p.detail && <span>{p.detail}</span>}</li>)}</ul> : <p class="muted small">{T.noCons}</p>}</div>
        </div>
        <p class="small muted">{T.pcNote} <a href={to(lang, '/methodology')}>{T.how}</a></p>
      </section>
    )
  }

  <nav class="tabs" aria-label={T.onPage}>
    {(pc.pros.length > 0 || pc.cons.length > 0) && <a href="#proscons">{T.pc}</a>}<a href="#overview">{T.overview}</a>{prevY && <a href="#changes">{T.changed}</a>}{sp && <a href="#trims">{T.trims}</a>}{y.dims.length > 0 && <a href="#dimensions">{T.dims}</a>}<a href="#engines">{T.engMpg}</a><a href="#safety">{T.safety}</a>{(y.similar?.length ?? 0) > 0 && <a href="#similar">{T.similar}</a>}<a href="#recalls">{T.recalls}</a><a href="#problems">{T.problems}</a>{usedYear && <a href="#checklist">{T.checklist}</a>}
  </nav>

  <section class="section overview" id="overview">
    <h2 style="margin-bottom:10px">{T.overview}</h2>
    {summary.map((p) => <p>{p}</p>)}
  </section>

  {
    prevY && (
      <section class="section" id="changes">
        <div class="section-head"><h2>{T.changedFor}</h2></div>
        {changes.length ? <ul class="changes">{changes.map((ch) => <li class={ch.redesign ? 'big' : ''}>{ch.text}</li>)}</ul> : <p class="muted">{T.noChange(prevY.year)}</p>}
        <p class="small muted">{T.changeNote(prevY.year)}{prevY.page && <> <a href={yearLink(m, prevY.year, prevY.es)}>{T.see(prevY.year)}</a></>}</p>
      </section>
    )
  }

  {
    sp && (
      <section class="section" id="trims">
        <div class="section-head"><h2>{T.trimsH}</h2></div>
        <div class="spec-grid">
          {sp.engines.map((e) => (
            <div class="spec-card">
              <span class="eyebrow">{e.label === 'Electric motor' ? T.powertrain : T.engine}</span>
              <b class="spec-big">{e.hp ? hpText(e.hp) : e.kw ? `${Math.round(e.kw * 1.341)} hp` : '–'}</b>
              <span>{engineL(lang, e.label)}{e.kw && e.hp ? T.plusMotor(Math.round(e.kw * 1.341)) : ''}</span>
            </div>
          ))}
          {sp.trans.length > 0 && <div class="spec-card"><span class="eyebrow">{T.trans}</span><b class="spec-mid">{sp.trans.map((x) => transL(lang, x)).join(' · ')}</b></div>}
          {sp.drive.length > 0 && <div class="spec-card"><span class="eyebrow">{T.drv}</span><b class="spec-mid">{sp.drive.join(' · ')}</b></div>}
          {sp.seats && <div class="spec-card"><span class="eyebrow">{T.seating}</span><b class="spec-mid">{seatsText(sp.seats)} {T.seatsW}{sp.rows ? ` · ${sp.rows} ${T.rows}` : ''}</b></div>}
        </div>
        {sp.trims.length > 0 && (<><h3 style="margin:22px 0 10px">{T.trimsList}</h3><div class="chips static">{sp.trims.map((t) => <span>{t}</span>)}</div></>)}
        {sp.features && (
          <>
            <h3 style="margin:22px 0 10px">{T.features}</h3>
            <div class="feat-grid">
              {Object.entries(sp.features).map(([k, v]) => <div class="feat"><span>{featureL(lang, k)}</span><span class={`badge ${v === 'std' ? 'good' : v === 'some' ? 'warn' : ''}`}>{T.featV[v]}</span></div>)}
              {sp.led && <div class="feat"><span>{T.led}</span><span class="badge good">{T.yes}</span></div>}
            </div>
          </>
        )}
        {sp.plants.length > 0 && <p class="small" style="margin-top:16px"><b>{T.built}</b> {sp.plants.join(' · ')}</p>}
        <p class="small muted">{T.specNote(sp.n)} <a href={to(lang, '/methodology')}>{T.how}</a></p>
      </section>
    )
  }

  {
    y.dims.length > 0 && (
      <section class="section" id="dimensions">
        <div class="section-head"><h2>{T.dimsH}</h2></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>{T.body}</th><th class="num">{T.length}</th><th class="num">{T.width}</th><th class="num">{T.height}</th><th class="num">{T.wb}</th><th class="num">{T.track}</th><th class="num">{T.weight}</th><th class="num">{T.wdist}</th></tr></thead>
            <tbody>
              {y.dims.map((d) => (
                <tr>
                  <td>{bodyName(d.name, m.model)}</td>
                  <td class="num">{d.length ? `${d.length} in` : '–'}</td>
                  <td class="num">{d.width ? `${d.width} in` : '–'}</td>
                  <td class="num">{d.height ? `${d.height} in` : '–'}</td>
                  <td class="num">{d.wheelbase ? `${d.wheelbase} in` : '–'}</td>
                  <td class="num">{d.trackF ? `${d.trackF} / ${d.trackR ?? '–'} in` : '–'}</td>
                  <td class="num">{d.weight ? `${num(lang, Math.round(d.weight))} lb` : '–'}</td>
                  <td class="num">{d.weightDist ?? '–'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="small muted">{T.dimsNote}</p>
        <a class="cta ghost" href={`${to(lang, '/tools/garage-fit')}?a=${encodeURIComponent(`${m.make} ${m.model}`)}`}>{T.garage}</a>
      </section>
    )
  }

  <section class="section" id="engines">
    <div class="section-head"><h2>{T.engH}</h2></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>{T.version}</th><th>{T.engine}</th><th>{T.trans}</th><th>{T.drv}</th><th class="num">{T.cityHwy}</th><th class="num">{T.vsClass}</th><th class="num">{T.fuelYr}</th><th class="num">{T.co2}</th></tr></thead>
        <tbody>
          {
            y.variants.map((v) => (
              <tr>
                <td>{v.name}{v.type && <> <span class="badge">{fuelL(lang, v.type)}</span></>}</td>
                <td>{v.type === 'EV' ? v.motor ?? T.electric : engineL(lang, `${v.displ ? `${v.displ.toFixed(1)}L ` : ''}${v.cyl ? `${v.cyl}-cyl` : ''}${v.turbo ? ' turbo' : ''}`)}</td>
                <td>{v.trans ? transL(lang, v.trans) : '–'}</td>
                <td>{v.drive ? driveL(lang, v.drive) : '–'}</td>
                <td class="num">{v.type === 'EV' ? `${v.range ?? '–'} mi${v.kwh ? ` · ${v.kwh} kWh/100mi` : ''}` : `${v.city ?? '–'} / ${v.hwy ?? '–'} / ${v.comb ?? '–'}`}</td>
                <td class={`num ${v.vsClass && v.vsClass > 0 ? 'good' : v.vsClass && v.vsClass < 0 ? 'bad' : ''}`}>{v.vsClass === undefined ? '–' : `${v.vsClass > 0 ? '+' : ''}${v.vsClass}%`}</td>
                <td class="num">{money(lang, v.cost)}</td>
                <td class="num">{v.co2 ? Math.round(v.co2) : '–'}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="stats">
      {y.feScore && <div class="stat"><b>{y.feScore}/10</b><span>{T.feScore}</span></div>}
      {y.ghgScore && <div class="stat"><b>{y.ghgScore}/10</b><span>{T.ghg}</span></div>}
      {y.save5 !== undefined && <div class="stat"><b class={y.save5 > 0 ? 'good' : 'bad'}>{y.save5 > 0 ? T.save(money(lang, y.save5)) : T.spend(money(lang, -y.save5))}</b><span>{T.fuel5}</span></div>}
      {y.classAvg && <div class="stat"><b>{y.classAvg} MPG</b><span>{T.avg}</span></div>}
    </div>
    <p class="small muted">{T.engNote} <a href={to(lang, '/methodology')}>{T.how}</a></p>
  </section>

  <Ad place="content" lang={lang} />

  <section class="section" id="safety">
    <div class="section-head"><h2>{T.safetyH}</h2></div>
    {
      y.rating?.length ? (
        <>
          <div class="table-wrap">
            <table>
              <thead><tr><th>{T.version}</th><th>{T.overall}</th><th>{T.frontal}</th><th>{T.drvPass}</th><th>{T.side}</th><th>{T.pole}</th><th>{T.rollover}</th><th class="num">{T.risk}</th></tr></thead>
              <tbody>
                {y.rating.map((r) => (
                  <tr>
                    <td>{r.desc}</td>
                    <td><Stars value={r.overall} lang={lang} /></td>
                    <td><Stars value={r.front} lang={lang} /></td>
                    <td>{r.frontDriver ?? '–'}★ / {r.frontPassenger ?? '–'}★</td>
                    <td><Stars value={r.side} lang={lang} /></td>
                    <td><Stars value={r.sidePole} lang={lang} /></td>
                    <td><Stars value={r.rollover} lang={lang} /></td>
                    <td class="num">{r.rolloverRisk ? `${r.rolloverRisk}%` : '–'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {ratingTop && (ratingTop.esc || ratingTop.fcw || ratingTop.ldw) && (
            <div class="stats">
              {ratingTop.esc && <div class="stat"><b>{availL(lang, ratingTop.esc)}</b><span>{T.esc}</span></div>}
              {ratingTop.fcw && <div class="stat"><b>{availL(lang, ratingTop.fcw)}</b><span>{T.fcw}</span></div>}
              {ratingTop.ldw && <div class="stat"><b>{availL(lang, ratingTop.ldw)}</b><span>{T.ldw}</span></div>}
            </div>
          )}
          {crashPics.length > 0 && (
            <div class="crash">
              {crashPics.map((p) => (
                <figure><img src={p.src} alt={p.cap} loading="lazy" decoding="async" /><figcaption>{p.cap}. {T.photoN}</figcaption></figure>
              ))}
            </div>
          )}
        </>
      ) : (
        <p class="muted">{T.noRating}</p>
      )
    }
  </section>

  {
    (y.similar?.length ?? 0) > 0 && (
      <section class="section" id="similar">
        <div class="section-head"><h2>{T.similarH}</h2></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>{T.model}</th><th class="num">{T.bestMpg}</th><th>{T.nhtsaOverall}</th><th class="num">{T.recalls}</th></tr></thead>
            <tbody>
              <tr style="background:var(--brand-soft)"><td><b>{name}</b> {T.thisCar}</td><td class="num">{y.mpg ? `${y.mpg.max} MPG` : y.range ? `${y.range} mi` : '–'}</td><td><Stars value={y.overall} lang={lang} /></td><td class="num">{recalls.length}</td></tr>
              {y.similar!.map((s) => (
                <tr>
                  <td><a href={yearLink(s, s.year, s.es)}>{es ? `${s.make} ${s.model} ${s.year}` : `${s.year} ${s.make} ${s.model}`}</a></td>
                  <td class="num">{s.mpg ? `${s.mpg} MPG` : s.range ? `${s.range} mi` : '–'}</td>
                  <td><Stars value={s.overall} lang={lang} /></td>
                  <td class="num">{s.recalls}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  <section class="section" id="recalls">
    <div class="section-head"><h2>{T.recallsH}</h2></div>
    {flags.length > 0 && <div class="note" style="background:var(--bad-bg);margin:0 0 12px"><b>{T.advisory}</b> {T.advisoryText(flags.length)}</div>}
    {es && recalls.length > 0 && <p class="small muted" style="margin:0 0 8px">{T.officialEn}</p>}
    {
      recalls.length ? (
        recalls.map((r) => (
          <details class="recall-item">
            <summary>
              {compL(lang, r.comps[0])} <span class="small muted">· {day(lang, r.date)}</span> {r.doNotDrive && <span class="badge bad">{T.dnd}</span>} {r.parkOutside && <span class="badge warn">{T.park}</span>}
            </summary>
            <p class="small muted" style="margin:6px 0 0">{T.campaign} <a href={campaignUrl(r.id)} target="_blank" rel="noopener">{r.id}</a>{r.units ? ` · ${num(lang, r.units)} ${T.vehicles}` : ''}</p>
            <dl lang="en">
              {r.summary && (<><dt>{T.problem}</dt><dd>{r.summary}</dd></>)}
              {r.consequence && (<><dt>{T.riskL}</dt><dd>{r.consequence}</dd></>)}
              {r.remedy && (<><dt>{T.fix}</dt><dd>{r.remedy}</dd></>)}
            </dl>
          </details>
        ))
      ) : (
        <p class="muted">{T.noRecalls}</p>
      )
    }
    <a class="cta" href={VIN_LOOKUP} target="_blank" rel="noopener">{T.vinBtn}</a>
    <p class="small muted" style="margin:6px 0 0">{T.recallNote}</p>
  </section>

  <section class="section" id="problems">
    <div class="section-head"><h2>{T.problemsH}</h2></div>
    {
      c.total ? (
        <>
          <div class="stats" style="margin-top:0">
            <div class="stat"><b>{num(lang, c.total)}</b><span>{T.cmplSince}</span></div>
            <div class="stat"><b>{num(lang, c.crash)}</b><span>{T.crash}</span></div>
            <div class="stat"><b>{num(lang, c.fire)}</b><span>{T.fire}</span></div>
            <div class="stat"><b>{num(lang, c.injured)}</b><span>{T.injured}</span></div>
            {c.miles && <div class="stat"><b>{num(lang, c.miles)} mi</b><span>{T.miles}</span></div>}
          </div>
          <div class="card bars" style="margin-top:14px">
            {c.comps.map(([cname, count]) => (
              <div class="bar"><span>{compL(lang, cname)}</span><span class="muted">{num(lang, count)}</span><i style={`width:${Math.max(2, (count / c.comps[0][1]) * 100)}%`} /></div>
            ))}
          </div>
          <Bars data={months.map(([k, v]) => [k.slice(2).replace('-', '/'), v])} caption={T.perMonth} lang={lang} />
          <p class="small muted">{T.cmplNote}</p>
        </>
      ) : (
        <p class="muted">{T.noCmpl}</p>
      )
    }
  </section>

  {usedYear && <UsedChecklist m={m} y={y} recalls={recalls} lang={lang} />}

  {
    others.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>{T.otherH}</h2><a href={to(lang, href(m))}>{T.compareAll}</a></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>{T.yearH}</th><th class="num">{T.mpgBest}</th><th class="num">{T.length}</th><th>{T.overall}</th><th class="num">{T.recalls}</th><th class="num">{T.complaints}</th></tr></thead>
            <tbody>
              {others.slice(0, 12).map((o) => (
                <tr>
                  <td><a href={yearLink(m, o.year, o.es)}>{yName(o.year)}</a></td>
                  <td class="num">{o.mpg?.max ?? (o.range ? `${o.range} mi` : '–')}</td>
                  <td class="num">{o.dims.find((d) => d.length)?.length ? `${o.dims.find((d) => d.length)!.length} in` : '–'}</td>
                  <td><Stars value={o.overall} lang={lang} /></td>
                  <td class="num">{o.recalls.length}</td>
                  <td class="num">{num(lang, o.complaints.total)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  <Ad place="bottom" lang={lang} />
  <p class="source">{T.source} <a href={to(lang, '/methodology')}>{T.how}</a></p>
</Base>
