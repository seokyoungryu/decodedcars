---
// Car loan calculator (pure math in the browser; the APR is an editable example, not a market rate)
import Base from '@/layouts/Base.astro';
import Ad from '@/components/Ad.astro';
import { type Lang, to } from '@/i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const es = lang === 'es';
const T = es
  ? {
      title: 'Calculadora de préstamo de auto: pago mensual, intereses y plazo',
      desc: 'Calculadora gratis de préstamo de auto: pago mensual, intereses totales y costo total según precio, enganche, auto a cuenta, impuesto, APR y plazo, y cuánto auto cabe en tu presupuesto mensual.',
      tools: 'Herramientas', h1: 'Calculadora de préstamo de auto', lead: 'Mira el pago mensual y cuánto cuesta realmente el préstamo, y compara plazos lado a lado.',
      pay: 'Pago según el precio', budget: 'Precio según tu presupuesto', price: 'Precio del vehículo ($)', monthly: 'Presupuesto mensual ($)', down: 'Enganche ($)', trade: 'Valor del auto a cuenta ($)', owed: 'Lo que aún debes del auto a cuenta ($)',
      tax: 'Impuesto sobre la venta (%)', fees: 'Cargos: título, registro, documentación ($)', apr: 'APR (%)', term: 'Plazo', months: (t: number) => `${t} meses (${t / 12} años)`,
      termsH: 'El mismo auto, distintos plazos', termsNote: 'Los plazos largos bajan el pago, pero cuestan más intereses y puedes deber más de lo que vale el auto por más tiempo.',
      balH: 'Saldo por año', howH: 'Cómo se calcula',
      how1: 'Monto financiado = precio + impuesto + cargos − enganche − auto a cuenta + lo que aún se deba del auto a cuenta. El impuesto se cobra sobre el precio menos el auto a cuenta, como en la mayoría de los estados de EE. UU. (algunos lo cobran sobre el precio completo). El pago usa la fórmula estándar de amortización a tasa fija con capitalización mensual.',
      how2: 'El APR es solo un ejemplo: usa la tasa de tu preaprobación o la cotización del concesionario. Las tasas dependen de tu crédito, el plazo y si el auto es nuevo o usado. Es una estimación, no una oferta de préstamo.',
    }
  : {
      title: 'Car Loan Calculator: Monthly Payment, Interest & Term',
      desc: 'Free car loan calculator: monthly payment, total interest and total cost for any price, down payment, trade-in, sales tax, APR and loan term — plus how much car fits your monthly budget.',
      tools: 'Tools', h1: 'Car loan calculator', lead: 'See the monthly payment and what the loan really costs — then compare loan lengths side by side.',
      pay: 'Payment for a price', budget: 'Price for a budget', price: 'Vehicle price ($)', monthly: 'Monthly budget ($)', down: 'Down payment ($)', trade: 'Trade-in value ($)', owed: 'Amount still owed on trade-in ($)',
      tax: 'Sales tax (%)', fees: 'Fees: title, registration, doc ($)', apr: 'APR (%)', term: 'Loan term', months: (t: number) => `${t} months (${t / 12} years)`,
      termsH: 'Same car, different loan lengths', termsNote: 'Longer loans lower the payment but cost more interest, and you can owe more than the car is worth for longer.',
      balH: 'Balance by year', howH: 'How this is calculated',
      how1: 'Amount financed = price + sales tax + fees − down payment − trade-in + any amount still owed on the trade-in. Sales tax is charged on the price minus the trade-in, as in most U.S. states (some states tax the full price). The payment uses the standard fixed-rate amortization formula with monthly compounding.',
      how2: "The APR here is only an example — use the rate from your own pre-approval or the dealer's quote. Rates depend on your credit, the loan length and whether the car is new or used. This is an estimate, not a loan offer.",
    };
const JS = es
  ? { locale: 'es-US', shop: 'Puedes buscar autos de hasta', monthlyPay: 'Pago mensual', atBudget: 'de precio con {p}/mes durante {n} meses', forTerm: 'durante {n} meses al {a} % de APR', financed: 'Monto financiado', interest: 'Intereses totales', totalPay: 'Total de pagos', totalCost: 'Costo total con enganche', principal: 'Capital', interestL: 'Intereses', term: 'Plazo', monthly: 'Mensual', maxPrice: 'Precio máx.', totalPaid: 'Total pagado', monthsW: 'meses', endOf: 'Al final del', yearW: 'Año', paidSoFar: 'Intereses pagados', balance: 'Saldo restante' }
  : { locale: 'en-US', shop: 'You can shop up to', monthlyPay: 'Monthly payment', atBudget: 'vehicle price at {p}/month for {n} months', forTerm: 'for {n} months at {a}% APR', financed: 'Amount financed', interest: 'Total interest', totalPay: 'Total of payments', totalCost: 'Total cost incl. down payment', principal: 'Principal', interestL: 'Interest', term: 'Term', monthly: 'Monthly', maxPrice: 'Max price', totalPaid: 'Total paid', monthsW: 'months', endOf: 'End of', yearW: 'Year', paidSoFar: 'Interest paid so far', balance: 'Balance left' };
---

<Base title={T.title} description={T.desc} section="tools" lang={lang} alt={es ? '/tools/car-loan' : '/es/tools/car-loan'}>
  <div class="crumbs"><a href={to(lang, '/tools')}>{T.tools}</a></div>
  <h1>{T.h1}</h1>
  <p class="lead">{T.lead}</p>

  <div class="tool-grid section">
    <form class="card form" id="lf" onsubmit="return false">
      <div class="seg" role="tablist">
        <label><input type="radio" name="mode" value="pay" checked /> {T.pay}</label>
        <label><input type="radio" name="mode" value="budget" /> {T.budget}</label>
      </div>
      <label data-mode="pay">{T.price}<input name="price" type="number" min="0" step="500" value="35000" /></label>
      <label data-mode="budget" hidden>{T.monthly}<input name="budget" type="number" min="0" step="25" value="600" /></label>
      <label>{T.down}<input name="down" type="number" min="0" step="500" value="5000" /></label>
      <label>{T.trade}<input name="trade" type="number" min="0" step="500" value="0" /></label>
      <label>{T.owed}<input name="owed" type="number" min="0" step="500" value="0" /></label>
      <label>{T.tax}<input name="tax" type="number" min="0" max="15" step="0.1" value="6" /></label>
      <label>{T.fees}<input name="fees" type="number" min="0" step="50" value="800" /></label>
      <label>{T.apr}<input name="apr" type="number" min="0" max="40" step="0.1" value="7" /></label>
      <label>{T.term}
        <select name="term">{[24, 36, 48, 60, 72, 84].map((t) => <option value={t} selected={t === 60}>{T.months(t)}</option>)}</select>
      </label>
    </form>
    <div id="out" aria-live="polite"></div>
  </div>
  <script type="application/json" id="i18n" set:html={JSON.stringify(JS)} />

  <section class="section">
    <div class="section-head"><h2>{T.termsH}</h2></div>
    <div class="table-wrap"><table id="terms"></table></div>
    <p class="small muted">{T.termsNote}</p>
  </section>

  <section class="section">
    <div class="section-head"><h2>{T.balH}</h2></div>
    <div class="table-wrap"><table id="amort"></table></div>
  </section>

  <section class="section prose">
    <h2>{T.howH}</h2>
    <p>{T.how1}</p>
    <p>{T.how2}</p>
  </section>
  <Ad place="bottom" lang={lang} />
</Base>

<script>
  const L = JSON.parse(document.getElementById('i18n')!.textContent!);
  const fill = (t: string, v: Record<string, string | number>) => t.replace(/\{(\w+)\}/g, (_, k) => String(v[k]));
  const form = document.getElementById('lf') as HTMLFormElement;
  const out = document.getElementById('out')!;
  const usd = (v: number) => `$${Math.round(v).toLocaleString(L.locale)}`;
  const num = (f: FormData, k: string) => Math.max(0, Number(f.get(k)) || 0);

  /** monthly payment for principal p, annual rate r (%), n months */
  const payment = (p: number, r: number, n: number) => (r === 0 ? p / n : (p * (r / 1200)) / (1 - (1 + r / 1200) ** -n));
  /** principal that a monthly payment pays off */
  const principalFor = (pay: number, r: number, n: number) => (r === 0 ? pay * n : (pay * (1 - (1 + r / 1200) ** -n)) / (r / 1200));

  /** amount financed for a vehicle price */
  function financed(price: number, f: FormData) {
    const taxable = Math.max(0, price - num(f, 'trade'));
    return Math.max(0, price + (taxable * num(f, 'tax')) / 100 + num(f, 'fees') - num(f, 'down') - num(f, 'trade') + num(f, 'owed'));
  }
  /** the price whose amount financed equals `p` (inverse of financed) */
  function priceFor(p: number, f: FormData) {
    const t = num(f, 'tax') / 100;
    const price = (p - num(f, 'fees') + num(f, 'down') + num(f, 'trade') - num(f, 'owed') + t * num(f, 'trade')) / (1 + t);
    return Math.max(0, price);
  }

  function render() {
    const f = new FormData(form);
    const mode = f.get('mode');
    form.querySelectorAll<HTMLElement>('[data-mode]').forEach((el) => (el.hidden = el.dataset.mode !== mode));
    const apr = num(f, 'apr'), n = Number(f.get('term'));
    let price: number, p: number, pay: number;
    if (mode === 'budget') {
      pay = num(f, 'budget');
      p = principalFor(pay, apr, n);
      price = priceFor(p, f);
    } else {
      price = num(f, 'price');
      p = financed(price, f);
      pay = payment(p, apr, n);
    }
    const interest = pay * n - p;
    const upfront = num(f, 'down');
    out.innerHTML = `<div class="result-card">
      <span class="eyebrow">${mode === 'budget' ? L.shop : L.monthlyPay}</span>
      <b class="big-num">${mode === 'budget' ? usd(price) : usd(pay)}</b>
      <span class="muted">${mode === 'budget' ? fill(L.atBudget, { p: usd(pay), n }) : fill(L.forTerm, { n, a: apr })}</span>
      <dl class="facts compact">
        <dt>${L.financed}</dt><dd>${usd(p)}</dd>
        <dt>${L.interest}</dt><dd>${usd(interest)}</dd>
        <dt>${L.totalPay}</dt><dd>${usd(pay * n)}</dd>
        <dt>${L.totalCost}</dt><dd>${usd(pay * n + upfront)}</dd>
      </dl>
      <div class="split" aria-label="${L.principal} / ${L.interestL}"><span style="flex:${p}"></span><span style="flex:${Math.max(interest, 0)}"></span></div>
      <div class="legend small"><span><i class="dot a"></i>${L.principal} ${usd(p)}</span><span><i class="dot b"></i>${L.interestL} ${usd(interest)}</span></div>
    </div>`;

    const rows = [36, 48, 60, 72, 84].map((t) => {
      const q = mode === 'budget' ? principalFor(pay, apr, t) : p;
      const m = mode === 'budget' ? pay : payment(q, apr, t);
      return `<tr${t === n ? ' class="hl"' : ''}><td>${t} ${L.monthsW}</td><td class="num">${usd(m)}</td><td class="num">${usd(m * t - q)}</td><td class="num">${mode === 'budget' ? usd(priceFor(q, f)) : usd(m * t)}</td></tr>`;
    });
    document.getElementById('terms')!.innerHTML = `<thead><tr><th>${L.term}</th><th class="num">${L.monthly}</th><th class="num">${L.interestL}</th><th class="num">${mode === 'budget' ? L.maxPrice : L.totalPaid}</th></tr></thead><tbody>${rows.join('')}</tbody>`;

    const yrs: string[] = [];
    let bal = p, paidI = 0;
    for (let i = 1; i <= n; i++) {
      const int = (bal * apr) / 1200;
      paidI += int;
      bal = Math.max(0, bal - (pay - int));
      if (i % 12 === 0 || i === n) yrs.push(`<tr><td>${L.yearW} ${Math.ceil(i / 12)}</td><td class="num">${usd(paidI)}</td><td class="num">${usd(bal)}</td></tr>`);
    }
    document.getElementById('amort')!.innerHTML = `<thead><tr><th>${L.endOf}</th><th class="num">${L.paidSoFar}</th><th class="num">${L.balance}</th></tr></thead><tbody>${yrs.join('')}</tbody>`;
  }
  form.addEventListener('input', render);
  render();
</script>
