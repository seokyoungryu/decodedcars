---
import '@/styles/global.css';
import { SITE_URL } from '@/config/site-url.mjs';
import { ADSENSE_CLIENT, SITE_DESCRIPTION, SITE_NAME, VIN_LOOKUP } from '@/config/site';
import { type Lang, UI, to } from '@/i18n';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  section?: 'makes' | 'recalls' | 'rankings' | 'guide' | 'finder' | 'compare' | 'tools';
  jsonLd?: Record<string, unknown>[];
  lang?: Lang;
  /** this page's path in the other language, when that version exists (hreflang + language switch) */
  alt?: string;
}
const { title, noindex = false, section, jsonLd = [], lang = 'en', alt } = Astro.props;
const description = Astro.props.description ?? (lang === 'es' ? 'Ficha técnica, dimensiones, consumo, pruebas de choque, retiros y problemas reportados de cada auto, camioneta y SUV desde 2005, comparados año por año y actualizados a diario.' : SITE_DESCRIPTION);
const t = UI[lang];
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/(index)?$/, '') || '/';
const home = path === '/' || path === '/es';
const fullTitle = home ? `${SITE_NAME} — ${t.tagline}` : `${title} | ${SITE_NAME}`;
const canonical = new URL(path, SITE_URL).href;
const altUrl = alt ? new URL(alt, SITE_URL).href : undefined;
const enUrl = lang === 'en' ? canonical : altUrl;
const esUrl = lang === 'es' ? canonical : altUrl;
// Spanish pages link to the English versions of sections that are not translated (yet)
const NAV = [
  { href: to(lang, '/finder'), key: 'finder', label: t.finder },
  { href: lang === 'es' ? '/compare' : '/compare', key: 'compare', label: t.compare },
  { href: to(lang, '/makes'), key: 'makes', label: t.makes },
  ...(lang === 'en' ? [{ href: '/rankings', key: 'rankings', label: t.rankings }] : []),
  { href: to(lang, '/tools'), key: 'tools', label: t.tools },
  { href: '/recalls', key: 'recalls', label: t.recalls },
];
---

<!doctype html>
<html lang={lang === 'es' ? 'es' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0d11" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {enUrl && esUrl && !noindex && (<><link rel="alternate" hreflang="en" href={enUrl} /><link rel="alternate" hreflang="es" href={esUrl} /><link rel="alternate" hreflang="x-default" href={enUrl} /></>)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {jsonLd.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {ADSENSE_CLIENT && <meta name="google-adsense-account" content={ADSENSE_CLIENT} />}
    {ADSENSE_CLIENT && !noindex && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous" />}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href={to(lang, '/')} class="logo"><img src="/favicon.svg" alt="" width="28" height="28" />{SITE_NAME}</a>
        <nav class="nav" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
          {NAV.map((n) => <a href={n.href} aria-current={section === n.key ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        {alt && <a class="lang-switch" href={alt} hreflang={lang === 'es' ? 'en' : 'es'} lang={lang === 'es' ? 'en' : 'es'} title={t.switchLabel}>{lang === 'es' ? 'EN' : 'ES'}</a>}
      </div>
    </header>
    <main><div class="wrap"><slot /></div></main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-top">
          <div>
            <a href={to(lang, '/')} class="logo"><img src="/favicon.svg" alt="" width="28" height="28" />{SITE_NAME}</a>
            <p>{t.tagline}. {t.footerAbout}</p>
          </div>
          <div>
            <h4>{t.research}</h4>
            <ul><li><a href={to(lang, '/finder')}>{t.finder}</a></li><li><a href="/compare">{t.compareCars}</a></li><li><a href={to(lang, '/makes')}>{t.allMakes}</a></li>{lang === 'en' && <li><a href="/rankings">{t.rankings}</a></li>}<li><a href="/recalls">{t.newRecalls}</a></li></ul>
          </div>
          <div>
            <h4>{t.tools}</h4>
            <ul><li><a href={to(lang, '/tools/vin-decoder')}>{t.vinTool}</a></li><li><a href={to(lang, '/tools/fuel-cost')}>{t.fuelTool}</a></li><li><a href={to(lang, '/tools/car-loan')}>{t.loanTool}</a></li><li><a href={to(lang, '/tools/garage-fit')}>{t.garageTool}</a></li></ul>
          </div>
          <div>
            <h4>{t.site}</h4>
            <ul><li><a href={to(lang, '/about')}>{t.about}</a></li>{lang === 'en' && <li><a href="/guide">{t.guides}</a></li>}<li><a href={to(lang, '/terms')}>{t.terms}</a></li><li><a href={to(lang, '/privacy')}>{t.privacy}</a></li><li><a href={to(lang, '/methodology')}>{lang === 'es' ? 'Metodología' : 'Methodology'}</a></li><li><a href={to(lang, '/contact')}>{t.contact}</a></li><li><a href={VIN_LOOKUP} rel="noopener" target="_blank">{t.vinCheck}</a></li>{alt && <li><a href={alt} hreflang={lang === 'es' ? 'en' : 'es'}>{t.switchTo}</a></li>}</ul>
          </div>
        </div>
        <p>{t.notice}</p>
        <p>{t.dataNote}</p>
        <p>© {new Date().getFullYear()} {SITE_NAME}</p>
      </div>
    </footer>
  </body>
</html>
