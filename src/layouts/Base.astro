---
import '@/styles/global.css';
import { SITE_URL } from '@/config/site-url.mjs';
import { ADSENSE_CLIENT, CONTACT_EMAIL, NOTICE, SITE_DESCRIPTION, SITE_NAME, SITE_TAGLINE, VIN_LOOKUP } from '@/config/site';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  section?: 'makes' | 'recalls' | 'rankings' | 'guide' | 'finder' | 'compare' | 'tools';
  jsonLd?: Record<string, unknown>[];
}
const { title, description = SITE_DESCRIPTION, noindex = false, section, jsonLd = [] } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/(index)?$/, '') || '/';
const fullTitle = path === '/' ? `${SITE_NAME} — ${SITE_TAGLINE}` : `${title} | ${SITE_NAME}`;
const canonical = new URL(path, SITE_URL).href;
const NAV = [
  { href: '/finder', key: 'finder', label: 'Car finder' },
  { href: '/compare', key: 'compare', label: 'Compare' },
  { href: '/makes', key: 'makes', label: 'Makes' },
  { href: '/rankings', key: 'rankings', label: 'Rankings' },
  { href: '/tools', key: 'tools', label: 'Tools' },
  { href: '/recalls', key: 'recalls', label: 'Recalls' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0d11" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {jsonLd.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {ADSENSE_CLIENT && <meta name="google-adsense-account" content={ADSENSE_CLIENT} />}
    {ADSENSE_CLIENT && !noindex && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous" />}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="logo"><img src="/favicon.svg" alt="" width="28" height="28" />{SITE_NAME}</a>
        <nav class="nav" aria-label="Main">
          {NAV.map((n) => <a href={n.href} aria-current={section === n.key ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main><div class="wrap"><slot /></div></main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-top">
          <div>
            <a href="/" class="logo"><img src="/favicon.svg" alt="" width="28" height="28" />{SITE_NAME}</a>
            <p>{SITE_TAGLINE}. Independent data from the EPA, NHTSA and Transport Canada, updated every day.</p>
          </div>
          <div>
            <h4>Research</h4>
            <ul><li><a href="/finder">Car finder</a></li><li><a href="/compare">Compare cars</a></li><li><a href="/makes">All makes</a></li><li><a href="/rankings">Rankings</a></li><li><a href="/recalls">New recalls</a></li></ul>
          </div>
          <div>
            <h4>Tools</h4>
            <ul><li><a href="/tools/vin-decoder">VIN decoder</a></li><li><a href="/tools/fuel-cost">Fuel cost calculator</a></li><li><a href="/tools/car-loan">Car loan calculator</a></li><li><a href="/tools/garage-fit">Garage fit</a></li></ul>
          </div>
          <div>
            <h4>Site</h4>
            <ul><li><a href="/about">About</a></li><li><a href="/guide">Guides</a></li><li><a href="/terms">Terms &amp; disclaimer</a></li><li><a href="/privacy">Privacy</a></li>{CONTACT_EMAIL && <li><a href={`mailto:${CONTACT_EMAIL}`}>Contact</a></li>}<li><a href={VIN_LOOKUP} rel="noopener" target="_blank">Check your VIN at NHTSA ↗</a></li></ul>
          </div>
        </div>
        <p>{NOTICE}</p>
        <p>Data: EPA fuel economy data; NHTSA recalls, consumer complaints and NCAP ratings; Transport Canada Canadian Vehicle Specifications — contains information licensed under the Open Government Licence – Canada; Wikipedia text (CC BY-SA 4.0), Wikimedia Commons photos (license shown under each photo) and pageview statistics (CC0). MPG figures are EPA estimates; your results will vary.</p>
        <p>© {new Date().getFullYear()} {SITE_NAME}</p>
      </div>
    </footer>
  </body>
</html>
